<UserControl x:Class="NovaChat.Client.Views.ManageUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="UserRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Manage Users" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="View, search and safely manage NovaChat accounts." Margin="0,7,0,0" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="←  Back to Chat" Style="{DynamicResource SecondaryButtonStyle}" Height="42" Click="BackButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Height="48">
                <Grid>
                    <TextBlock Text="⌕" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="SearchBox" Margin="44,0,12,0" BorderThickness="0" Background="Transparent" TextChanged="SearchBox_TextChanged" ToolTip="Search by name, email or user ID"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="↻  Refresh" Style="{DynamicResource SecondaryButtonStyle}" Height="48" Margin="12,0,0,0" Click="RefreshButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,8,10,10">
                        <TextBlock Text="Accounts" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="UsersList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource UserRowButtonStyle}" Tag="{Binding}" Click="UserRowButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource PrimarySoftBrush}">
                                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Email}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="No users found." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="18,0,0,0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="User Details" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <Border Width="82" Height="82" CornerRadius="41" HorizontalAlignment="Left" Background="{DynamicResource PrimarySoftBrush}">
                            <TextBlock x:Name="DetailInitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="DetailNameText" Margin="0,14,0,0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Text="Select a user"/>
                        <TextBlock x:Name="DetailIdText" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,24,0,0">
                        <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="DetailEmailText" Margin="0,5,0,14" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="JOINED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="DetailCreatedText" Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Deleting an account is permanent. The Owner account is protected and cannot be deleted from this panel." VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18"/>
                    <Button x:Name="DeleteButton" Grid.Row="4" Content="Delete User" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" Height="44" IsEnabled="False" Click="DeleteButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
