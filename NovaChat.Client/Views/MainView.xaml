<UserControl x:Class="NovaChat.Client.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="285"/><ColumnDefinition Width="*" MinWidth="520"/></Grid.ColumnDefinitions>

        <!-- Conversation sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="2,2,2,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource PrimaryBrush}"><TextBlock Text="N" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="NovaChat" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="AccountTypeText" Text="User Account" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/></StackPanel>
                    <Button Grid.Column="2" Content="•••" Style="{StaticResource IconButtonStyle}" ToolTip="More options"/>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Height="46" CornerRadius="13" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Grid><TextBlock Text="⌕" FontSize="21" Foreground="{DynamicResource SecondaryTextBrush}" Margin="13,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="SearchTextBox" Margin="40,0,8,0" Background="Transparent" BorderThickness="0"/></Grid>
                    </Border>
                    <Button Content="＋   New conversation" Height="44" Style="{StaticResource PrimaryButtonStyle}" Click="StartNewChatSafelyButton_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CONVERSATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,9"/>
                        <ItemsControl x:Name="ChatsList">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Height="72" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="68" Style="{StaticResource GhostButtonStyle}" Padding="8,0" HorizontalContentAlignment="Left" Click="ChatButton_Click">
                                        <Grid Width="250"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid Width="44" Height="44"><Ellipse Fill="{DynamicResource SelectedChatBrush}"/><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding AvatarUri}" Width="44" Height="44" Stretch="UniformToFill" IsHitTestVisible="False"><Image.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/></Image.Clip></Image><Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding OnlineVisibility}"/></Grid>
                                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Content="•••" Style="{StaticResource IconButtonStyle}" Width="34" Height="34" ToolTip="Delete this conversation" Click="DeleteSingleChatButton_Click"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoChatsText" Text="No conversations yet" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="9,14,0,0"/>

                        <Border x:Name="OwnerPanel" Visibility="Collapsed" Margin="4,22,4,0" Padding="0,16,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel><TextBlock Text="OWNER CONTROL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="4,0,0,8"/>
                                <Button Content="👥   Manage Users" Height="38" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="ManageUsersButton_Click"/>
                                <Button Content="💬   All Chats" Height="38" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="AllChatsButton_Click"/>
                                <Button Content="🗑   Delete Chats" Height="38" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="DeleteChatsButton_Click"/>
                                <Button Content="📊   Server Overview" Height="38" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="ServerOverviewButton_Click"/>
                                <Button Content="⚙   Admin Settings" Height="38" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="AdminSettingsButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button Content="👤   Profile" Height="42" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="ProfileButton_Click"/>
                    <Button Content="⚙   Settings" Height="42" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat area -->
        <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48" Cursor="Hand" MouseLeftButtonUp="ChatHeaderAvatarDirect_Click"><Ellipse x:Name="ChatAvatarBackground" Fill="{DynamicResource SelectedChatBrush}"/><TextBlock x:Name="ChatAvatarInitialsText" Text="N" Foreground="{DynamicResource PrimaryBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ChatHeaderAvatarImage" Width="48" Height="48" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"><Image.Clip><EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/></Image.Clip></Image><Ellipse x:Name="ChatAvatarStatusDot" Width="12" Height="12" Fill="{DynamicResource SecondaryTextBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0"><TextBlock x:Name="ChatUserNameText" Text="Select a conversation" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" MouseLeftButtonUp="ChatUserNameText_MouseLeftButtonUp"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="ChatStatusIndicator" Width="7" Height="7" Fill="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="ChatStatusText" Text="Offline" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⌕" Style="{StaticResource IconButtonStyle}" ToolTip="Search in conversation"/><Button Content="•••" Style="{StaticResource IconButtonStyle}" ToolTip="Conversation menu"/></StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" Padding="28,22" VerticalScrollBarVisibility="Auto" ScrollChanged="MessagesScrollViewer_ScrollChanged">
                <StackPanel x:Name="MessagesPanel">
                    <Border CornerRadius="22" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="34" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,90,0,90">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="24" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="💬" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Start a conversation" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                            <TextBlock Text="Choose a chat from the left, or create a new conversation to start messaging." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                            <Button Content="＋   Start a new chat" Style="{StaticResource PrimaryButtonStyle}" Height="44" Margin="0,22,0,0" Click="StartNewChatSafelyButton_Click"/>
                            <Button x:Name="LoadOlderMessagesButton" Content="Load older messages" Visibility="Collapsed" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Click="LoadOlderMessagesButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                    <Button Content="＋" Style="{StaticResource IconButtonStyle}" ToolTip="Attach file"/>
                    <Button Grid.Column="1" Content="🎙" Style="{StaticResource IconButtonStyle}" ToolTip="Voice message"/>
                    <Border Grid.Column="2" Height="48" CornerRadius="16" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="4,0,10,0"><TextBox x:Name="MessageTextBox" Background="Transparent" BorderThickness="0" Padding="14,0" FontSize="14" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown" ToolTip="Write a message"/></Border>
                    <Button Grid.Column="3" Content="Send  ➤" Height="46" Style="{StaticResource PrimaryButtonStyle}" Click="SendButton_Click" ToolTip="Send message"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>