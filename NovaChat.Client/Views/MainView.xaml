<UserControl x:Class="NovaChat.Client.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ACCOUNT -->

                <StackPanel Margin="0,0,0,20">

                    <TextBlock Text="NovaChat"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"/>

                    <TextBlock x:Name="AccountTypeText"
                               Text="User Account"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <!-- SEARCH -->

                <Border Grid.Row="1"
                        Height="42"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,20">

                    <TextBox x:Name="SearchTextBox"
                             FontSize="14"
                             Padding="12,0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"/>

                </Border>

                <!-- CHATS -->

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="CHATS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="4,0,0,10"/>

                        <Button Height="65"
                                Background="{DynamicResource SelectedChatBrush}"
                                BorderThickness="0"
                                Padding="12"
                                Margin="0,0,0,8">

                            <StackPanel>
                                <TextBlock Text="Ali"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Hey! How are you?"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                        </Button>

                        <Button Height="65"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12"
                                Margin="0,0,0,8">

                            <StackPanel>
                                <TextBlock Text="Reza"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="See you tomorrow!"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                        </Button>

                        <Button Height="65"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12">

                            <StackPanel>
                                <TextBlock Text="Sara"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Thanks!"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                        </Button>

                        <!-- OWNER ONLY -->

                        <Border x:Name="OwnerPanel"
                                Visibility="Collapsed"
                                Margin="0,25,0,0"
                                Padding="0,15,0,0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">

                            <StackPanel>

                                <TextBlock Text="OWNER CONTROL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="4,0,0,10"/>

                                <Button Content="👥 Manage Users"
                                        Height="42"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="ManageUsersButton_Click"/>

                                <Button Content="💬 All Chats"
                                        Height="42"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="AllChatsButton_Click"/>

                                <Button Content="🗑 Delete Chats"
                                        Height="42"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="DeleteChatsButton_Click"/>

                                <Button Content="📊 Server Overview"
                                        Height="42"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="ServerOverviewButton_Click"/>

                                <Button Content="⚙ Admin Settings"
                                        Height="42"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="AdminSettingsButton_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- BOTTOM -->

                <StackPanel Grid.Row="3"
                            Margin="0,15,0,0">

                    <Button Content="👤 Profile"
                            Height="44"
                            Background="Transparent"
                            Foreground="{DynamicResource TextBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Click="ProfileButton_Click"
                            Margin="0,0,0,6"/>

                    <Button Content="⚙ Settings"
                            Height="44"
                            Background="Transparent"
                            Foreground="{DynamicResource TextBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Click="SettingsButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- CHAT -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Ali"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Offline"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="20"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            Padding="12"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            MaxWidth="450"
                            Margin="0,0,0,12">

                        <TextBlock Text="Hey! Welcome to NovaChat 👋"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"/>

                    </Border>

                    <Border Background="{DynamicResource PrimaryBrush}"
                            Padding="12"
                            CornerRadius="12"
                            HorizontalAlignment="Right"
                            MaxWidth="450">

                        <TextBlock Text="Thanks! 😎"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="48"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBox FontSize="14"
                                 Padding="12,0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"/>

                    </Border>

                    <Button Grid.Column="1"
                            Content="Send"
                            Height="48"
                            Margin="10,0,0,0"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>