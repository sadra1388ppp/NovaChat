<UserControl x:Class="NovaChat.Client.Views.MainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{DynamicResource AppBackgroundBrush}">
<Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="270"/><ColumnDefinition Width="*" MinWidth="480"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="16,14,12,14">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="4,0,4,18"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource PrimaryBrush}"><TextBlock Text="N" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="NovaChat" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="AccountTypeText" Text="User Account" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Content="⋮" FontSize="20" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="More"/></Grid>
<StackPanel Grid.Row="1"><Border Height="44" CornerRadius="10" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10"><Grid><TextBlock Text="⌕" FontSize="22" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="SearchTextBox" Margin="38,0,10,0" FontSize="14" Padding="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" VerticalContentAlignment="Center"/></Grid></Border><Button Content="＋  New chat" Height="42" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="NewChatButton_Click"/><Button Content="👥  Groups" Height="40" Margin="0,7,0,0" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="SemiBold" Click="GroupsButton_Click"/></StackPanel>
<ScrollViewer Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="CONVERSATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,9"/><ItemsControl x:Name="ChatsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="70" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button Grid.Column="0" Height="66" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Left" Click="ChatButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Width="42" Height="42"><Ellipse Fill="{DynamicResource SelectedChatBrush}"/><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding OnlineVisibility}"/></Grid><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Button><Button Grid.Column="1" Width="30" Height="30" Content="⋮" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" ToolTip="Chat options" Click="DeleteChatButton_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoChatsText" Text="No conversations yet" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,14,0,0"/><Border x:Name="OwnerPanel" Visibility="Collapsed" Margin="4,22,4,0" Padding="0,16,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><StackPanel><TextBlock Text="OWNER CONTROL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="4,0,0,8"/><Button Content="👥  Manage Users" Height="38" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="ManageUsersButton_Click"/><Button Content="💬  All Chats" Height="38" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="AllChatsButton_Click"/><Button Content="🗑  Delete Chats" Height="38" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="DeleteChatsButton_Click"/><Button Content="📊  Server Overview" Height="38" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="ServerOverviewButton_Click"/><Button Content="⚙  Admin Settings" Height="38" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="AdminSettingsButton_Click"/></StackPanel></Border></StackPanel></ScrollViewer>
<StackPanel Grid.Row="3" Margin="0,10,0,0"><Button Content="👤  Profile" Height="40" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="ProfileButton_Click"/><Button Content="⚙  Settings" Height="40" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="SettingsButton_Click"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="50" Height="50" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource SelectedChatBrush}"/><TextBlock Text="N" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="ChatAvatarStatusDot" Width="12" Height="12" Fill="{DynamicResource SecondaryTextBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0"><TextBlock x:Name="ChatUserNameText" Text="Select a chat" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse x:Name="ChatStatusIndicator" Width="7" Height="7" Fill="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="ChatStatusText" Text="Offline" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⌕" Width="38" Height="38" FontSize="19" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="Search in chat"/><Button Content="⋮" Width="38" Height="38" FontSize="20" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="Chat menu"/></StackPanel></Grid></Border><ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto" ScrollChanged="MessagesScrollViewer_ScrollChanged"><StackPanel x:Name="MessagesPanel"><Button x:Name="LoadOlderMessagesButton" Content="Load older messages" Visibility="Collapsed" Margin="0,0,0,15" HorizontalAlignment="Center" Padding="15,7" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Click="LoadOlderMessagesButton_Click"/></StackPanel></ScrollViewer><Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Button Content="＋" Width="38" Height="38" FontSize="18" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" ToolTip="Attach"/><Border Grid.Column="1" Height="46" CornerRadius="12" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBox x:Name="MessageTextBox" FontSize="14" Padding="13,0" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown"/></Border><Button Grid.Column="2" Content="➤" Width="42" Height="42" Margin="8,0,0,0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontSize="17" Click="SendButton_Click" ToolTip="Send message"/></Grid></Border></Grid>
</Grid></UserControl>