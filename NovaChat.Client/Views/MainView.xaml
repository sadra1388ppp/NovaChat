<UserControl x:Class="NovaChat.Client.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- LOGO -->

                <TextBlock Text="NovaChat"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,20"/>


                <!-- SEARCH -->

                <Border Grid.Row="1"
                        Height="42"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,20">

                    <Grid>

                        <TextBox Text="Search"
                                 FontSize="14"
                                 Padding="12,0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"/>

                    </Grid>

                </Border>


                <!-- CONVERSATIONS -->

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <!-- ALI -->

                        <Button Height="70"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource SelectedChatBrush}"
                                BorderThickness="0"
                                Padding="12"
                                Margin="0,0,0,8">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Ali"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Hey! How are you?"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- REZA -->

                        <Button Height="70"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12"
                                Margin="0,0,0,8">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Reza"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="See you tomorrow!"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- SARA -->

                        <Button Height="70"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Sara"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Thanks!"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </ScrollViewer>


                <!-- BOTTOM NAVIGATION -->

                <StackPanel Grid.Row="3"
                            Margin="0,15,0,0">

                    <Button Content="👤 Profile"
                            Height="44"
                            Background="Transparent"
                            Foreground="{DynamicResource TextBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Click="ProfileButton_Click"
                            Margin="0,0,0,6"/>

                    <Button Content="⚙ Settings"
                            Height="44"
                            Background="Transparent"
                            Foreground="{DynamicResource TextBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Click="SettingsButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================= CHAT AREA ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <!-- HEADER -->

                <RowDefinition Height="90"/>

                <!-- MESSAGES -->

                <RowDefinition Height="*"/>

                <!-- INPUT -->

                <RowDefinition Height="80"/>

            </Grid.RowDefinitions>


            <!-- ================= CHAT HEADER ================= -->

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- AVATAR -->

                    <Ellipse Grid.Column="0"
                             Width="46"
                             Height="46"
                             Fill="{DynamicResource PrimaryBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0"/>


                    <!-- USER INFO -->

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Ali"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Offline"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= MESSAGES ================= -->

            <ScrollViewer Grid.Row="1"
                          Padding="20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- RECEIVED -->

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            Padding="12"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            MaxWidth="450"
                            Margin="0,0,0,12">

                        <TextBlock Text="Hey! Welcome to NovaChat 👋"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <!-- SENT -->

                    <Border Background="{DynamicResource PrimaryBrush}"
                            Padding="12"
                            CornerRadius="12"
                            HorizontalAlignment="Right"
                            MaxWidth="450"
                            Margin="0,0,0,12">

                        <TextBlock Text="Thanks! 😎"
                                   Foreground="White"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <!-- RECEIVED -->

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            Padding="12"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            MaxWidth="450">

                        <TextBlock Text="This is the NovaChat desktop client."
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>


            <!-- ================= MESSAGE INPUT ================= -->

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>


                    <!-- MESSAGE BOX -->

                    <Border Grid.Column="0"
                            Height="48"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBox Text="Type a message..."
                                 FontSize="14"
                                 Padding="12,0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"/>

                    </Border>


                    <!-- SEND -->

                    <Button Grid.Column="1"
                            Content="Send"
                            Height="48"
                            Margin="10,0,0,0"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>