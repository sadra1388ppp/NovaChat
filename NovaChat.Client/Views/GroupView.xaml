<Window x:Class="NovaChat.Client.Views.GroupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NovaChat Groups" Width="900" Height="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Groups" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel Grid.Row="1">
                <TextBox x:Name="GroupNameBox" Height="34" Margin="0,0,0,7" Padding="8" ToolTip="Group name"/>
                <TextBox x:Name="GroupDescriptionBox" Height="34" Margin="0,0,0,7" Padding="8" ToolTip="Description"/>
                <Button Content="＋ Create group" Height="36" Click="CreateGroup_Click"/>
            </StackPanel>
            <ListBox x:Name="GroupsList" Grid.Row="2" Margin="0,14,0,0" DisplayMemberPath="Name" SelectionChanged="GroupsList_SelectionChanged"/>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="360"><TextBlock x:Name="SelectedGroupName" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="SelectedGroupDescription" Foreground="Gray" Margin="0,3,0,0"/></StackPanel>
                <TextBox x:Name="MemberIdBox" Width="170" Height="32" Padding="7" Margin="10,0,5,0" ToolTip="User ID"/>
                <Button Content="Add member" Height="32" Click="AddMember_Click"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,14,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ListBox x:Name="MembersList" DisplayMemberPath="DisplayName" SelectionChanged="MembersList_SelectionChanged" Margin="0,0,12,0"/>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessagesPanel"/></ScrollViewer>
            </Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="MessageBox" Height="40" Padding="10" KeyDown="MessageBox_KeyDown"/><Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Click="Send_Click"/></Grid>
        </Grid>
    </Grid>
</Window>