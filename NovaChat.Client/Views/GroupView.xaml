<Window x:Class="NovaChat.Client.Views.GroupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NovaChat" Width="1100" Height="700" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,4"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#E4E8EE" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <Button Content="＋" Width="42" Height="42" FontSize="22" HorizontalAlignment="Right" Click="CreateGroup_Click" ToolTip="New group" DockPanel.Dock="Right"/>
                    <StackPanel><TextBlock Text="Groups" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Your conversations" Foreground="#7A8491" Margin="0,3,0,0"/></StackPanel>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="GroupNameBox" ToolTip="Group name"/>
                <TextBox Grid.Row="1" x:Name="GroupDescriptionBox" Visibility="Collapsed"/>
                <ListBox Grid.Row="2" x:Name="GroupsList" BorderThickness="0" Background="Transparent" SelectionChanged="GroupsList_SelectionChanged" Margin="0,12,0,0">
                    <ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,2"><Grid><Ellipse Width="48" Height="48" Fill="#E6E9FF" HorizontalAlignment="Left"/><TextBlock Text="👥" FontSize="22" HorizontalAlignment="Left" Margin="13,8,0,0"/><StackPanel Margin="62,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Description}" Foreground="#7A8491" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E4E8EE" BorderThickness="0,0,0,1" Padding="20,10">
                <DockPanel>
                    <Button Content="Add member" DockPanel.Dock="Right" Click="AddMember_Click"/>
                    <Ellipse Width="46" Height="46" Fill="#E6E9FF" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectedGroupName" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SelectedGroupDescription" Foreground="#7A8491"/></StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#FAFBFC" BorderBrush="#E4E8EE" BorderThickness="0,0,1,0" Padding="12"><DockPanel><TextBlock Text="Members" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="4,4,4,10"/><ListBox x:Name="MembersList" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent" SelectionChanged="MembersList_SelectionChanged"/></DockPanel></Border>
                <Grid Grid.Column="1">
                    <TextBlock Text="Select a group to start chatting" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A94A3" FontSize="16"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessagesPanel" Margin="24,18"/></ScrollViewer>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#E4E8EE" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="MessageBox" Height="46" VerticalContentAlignment="Center" KeyDown="MessageBox_KeyDown" ToolTip="Write a message..."/><Button Grid.Column="1" Content="Send  ➤" Height="46" Click="Send_Click"/></Grid>
            </Border>
            <TextBox x:Name="MemberIdBox" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>