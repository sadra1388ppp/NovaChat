<UserControl x:Class="NovaChat.Client.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel MaxWidth="760" Margin="28" HorizontalAlignment="Center">
                <TextBlock Text="Profile" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Your NovaChat identity, presence and account controls" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,20"/>
                <Border Padding="24" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="112" Height="112" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SelectedChatBrush}"/>
                            <Image x:Name="AvatarImage" Width="108" Height="108" Margin="2" Stretch="UniformToFill" IsHitTestVisible="False" Source="{Binding AvatarUrl}" Panel.ZIndex="2">
                                <Image.Clip><EllipseGeometry Center="54,54" RadiusX="54" RadiusY="54"/></Image.Clip>
                            </Image>
                            <TextBlock x:Name="AvatarInitialsText" Text="?" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvatarUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvatarUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse x:Name="ProfileStatusDot" Width="18" Height="18" Fill="{DynamicResource SecondaryTextBrush}" Stroke="{DynamicResource PanelBackgroundBrush}" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="3"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="18,2,0,0">
                            <TextBlock x:Name="ProfileDisplayNameText" Text="NovaChat User" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ProfileUserIdText" Text="@user" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ProfileBioText" Text="Add a short bio to tell people about yourself." FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,14,0,12"/>
                            <StackPanel Orientation="Horizontal"><Border Padding="10,5" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="9"><TextBlock x:Name="StatusText" Text="● Offline" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></Border><TextBlock x:Name="LastSeenText" Text="Last seen not available" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                            <TextBlock x:Name="JoinedText" Text="Joined" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Padding="20" Margin="0,16,0,0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Profile picture" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Use a clear square image. NovaChat will optimize it automatically." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Change picture" Click="ChangePictureButton_Click" Height="36" Padding="16,0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/><Button Content="Remove" Click="RemovePictureButton_Click" Height="36" Padding="16,0" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"/></StackPanel></StackPanel></Border>
                <Border Padding="20" Margin="0,16,0,0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Identity" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="These details are used across your NovaChat profile." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,16"/>
                        <TextBlock Text="Display Name" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="DisplayNameBox" Height="42" Margin="0,6,0,14" Padding="10" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="User ID" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <Grid Margin="0,6,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UserIdBox" Height="42" Padding="10" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/><Button Grid.Column="1" x:Name="CopyUserIdButton" Content="Copy" Width="70" Height="42" Margin="8,0,0,0" Click="CopyUserIdButton_Click" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"/></Grid>
                        <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="EmailBox" Height="42" Margin="0,6,0,14" Padding="10" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Phone Number" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="PhoneBox" Height="42" Margin="0,6,0,14" Padding="10" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Bio" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="BioBox" Height="92" Margin="0,6,0,4" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Maximum 160 characters" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="FeedbackText" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,14,0,10"/>
                        <Button x:Name="SaveButton" Content="Save changes" Click="SaveButton_Click" Height="44" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>
                <Border Padding="20" Margin="0,16,0,0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Security &amp; Privacy" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Keep your account secure and control how your presence appears." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,16"/><Border Padding="14" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Change password" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Update your NovaChat password without leaving your profile." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Open" Width="72" Height="34" Click="ChangePasswordButton_Click" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"/></Grid></Border><Border Padding="14" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Presence" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Your online state is shared to make chats feel live." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="PresenceSummaryText" Grid.Column="1" Text="Online presence" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border></StackPanel></Border>
                <Border Padding="20" Margin="0,16,0,24" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Account" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Button Content="Contacts" Click="ContactsButton_Click" Height="40" Margin="0,12,0,0" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" HorizontalContentAlignment="Left"/><Button Content="Back to Chat" Click="BackToChatButton_Click" Height="40" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" HorizontalContentAlignment="Left"/></StackPanel></Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>