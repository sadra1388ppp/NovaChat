<UserControl x:Class="NovaChat.Client.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Width="500" Padding="35" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Profile" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <Ellipse Width="90" Height="90" Fill="{DynamicResource PrimaryBrush}" Margin="0,25,0,15"/>
                <TextBlock Text="Sadra" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="@sadra123" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,25"/>
                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBox Text="example@email.com" Height="40" Margin="0,6,0,18" Padding="10" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}"/>
                <Button Content="Edit Profile" Height="42" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                <Button Content="Contacts" Height="42" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Click="ContactsButton_Click" Margin="0,0,0,10"/>
                <Button Content="Back to Chat" Height="42" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Click="BackToChatButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>