<UserControl x:Class="NovaChat.Client.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Background="#F5F7FB">

        <Border Width="420"
                Padding="35"
                Background="White"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="NovaChat"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#5865F2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Create your account"
                           FontSize="16"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="User ID"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="UserIdTextBox"
                         Height="42"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Display Name"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="DisplayNameTextBox"
                         Height="42"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="EmailTextBox"
                         Height="42"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             Padding="12"
                             FontSize="14"
                             Margin="0,0,0,25"/>

                <Button Content="Create Account"
                        Height="45"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#5865F2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RegisterButton_Click"/>

                <TextBlock Text="Already have an account?"
                           HorizontalAlignment="Center"
                           Foreground="#777777"
                           Margin="0,25,0,5"/>

                <Button Content="Back to Login"
                        Background="Transparent"
                        Foreground="#5865F2"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="BackToLoginButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>