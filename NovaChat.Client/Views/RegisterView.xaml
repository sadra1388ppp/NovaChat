<UserControl x:Class="NovaChat.Client.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0F1115">
    <UserControl.Resources>
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#18FFFFFF"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#66D4A373"/><Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><Border x:Name="Box" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/></Border><Border x:Name="FocusGlow" CornerRadius="14" BorderBrush="#00D4A373" BorderThickness="1" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#25FFFFFF"/><Setter TargetName="Box" Property="BorderBrush" Value="#90FFFFFF"/><Setter TargetName="FocusGlow" Property="BorderBrush" Value="#45D4A373"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="Background" Value="#30FFFFFF"/><Setter TargetName="Box" Property="BorderBrush" Value="#FFD4A373"/><Setter TargetName="FocusGlow" Property="BorderBrush" Value="#90D4A373"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox"><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#18FFFFFF"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Grid><Border x:Name="Box" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/></Border><Border x:Name="FocusGlow" CornerRadius="14" BorderBrush="#00D4A373" BorderThickness="1" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#25FFFFFF"/><Setter TargetName="Box" Property="BorderBrush" Value="#90FFFFFF"/><Setter TargetName="FocusGlow" Property="BorderBrush" Value="#45D4A373"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="Background" Value="#30FFFFFF"/><Setter TargetName="Box" Property="BorderBrush" Value="#FFD4A373"/><Setter TargetName="FocusGlow" Property="BorderBrush" Value="#90D4A373"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="GlassCreateButton" TargetType="Button"><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#D4A373"/><Setter Property="BorderBrush" Value="#E8C79C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid><Border CornerRadius="15" Margin="1" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5B98E"/><Setter TargetName="Surface" Property="BorderBrush" Value="#FFF4E6"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B98253"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="GlassBackButton" TargetType="Button"><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#D4A373"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="10" Padding="10,6" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#25D4A373"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DuplicateWarning" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF6B6B"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Visibility" Value="Collapsed"/></Style>
        <Style x:Key="PhoneHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#7B838E"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="14,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
    </UserControl.Resources>
    <Grid Background="#0F1115">
        <Border IsHitTestVisible="False" Opacity="0.55"><Border.Background><RadialGradientBrush Center="0.22,0.40" GradientOrigin="0.22,0.40" RadiusX="0.72" RadiusY="0.82"><GradientStop Color="#35FFD66E" Offset="0"/><GradientStop Color="#14FFD66E" Offset="0.35"/><GradientStop Color="#00FFD66E" Offset="1"/></RadialGradientBrush></Border.Background></Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="820" Margin="30"><Border Width="510" Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="28"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.35"/></Border.Effect><StackPanel>
            <Border Width="58" Height="58" CornerRadius="18" Background="#D4A373" HorizontalAlignment="Center"><TextBlock Text="N" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Create your NovaChat account" FontSize="27" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,18,0,6" TextAlignment="Center"/>
            <TextBlock Text="Everything you need to start chatting in one place." FontSize="13" Foreground="#BFC3CA" HorizontalAlignment="Center" Margin="0,0,0,24" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#D7D9DE" Margin="0,0,0,7"/><TextBox x:Name="UsernameTextBox" Style="{StaticResource GlassTextBox}" Height="46" TextChanged="UsernameTextBox_TextChanged"/><TextBlock x:Name="UsernameDuplicateText" Text="This username is already taken." Style="{StaticResource DuplicateWarning}"/>
            <TextBlock Text="Display Name" FontSize="12" FontWeight="SemiBold" Foreground="#D7D9DE" Margin="0,10,0,7"/><TextBox x:Name="DisplayNameTextBox" Style="{StaticResource GlassTextBox}" Height="46" Margin="0,0,0,13"/>
            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#D7D9DE" Margin="0,0,0,7"/><TextBox x:Name="EmailTextBox" Style="{StaticResource GlassTextBox}" Height="46" TextChanged="EmailTextBox_TextChanged"/><TextBlock x:Name="EmailDuplicateText" Text="This email is already registered." Style="{StaticResource DuplicateWarning}"/>
            <TextBlock Text="Phone Number" FontSize="12" FontWeight="SemiBold" Foreground="#D7D9DE" Margin="0,0,0,7"/><Grid><TextBox x:Name="PhoneNumberTextBox" Style="{StaticResource GlassTextBox}" Height="46" PreviewTextInput="PhoneNumberTextBox_PreviewTextInput" TextChanged="PhoneNumberTextBox_TextChanged" DataObject.Pasting="PhoneNumberTextBox_Pasting"/><TextBlock x:Name="PhoneHintText" Text="09987654321" Style="{StaticResource PhoneHint}"/></Grid><TextBlock x:Name="PhoneDuplicateText" Text="This phone number is already registered." Style="{StaticResource DuplicateWarning}"/><TextBlock x:Name="PhoneValidationText" Text="Phone number must contain exactly 11 digits and start with 0." Style="{StaticResource DuplicateWarning}"/>
            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#D7D9DE" Margin="0,0,0,7"/><PasswordBox x:Name="PasswordBox" Style="{StaticResource GlassPasswordBox}" Height="46" Margin="0,0,0,21"/>
            <Button x:Name="RegisterButton" Content="Create account" Height="50" Style="{StaticResource GlassCreateButton}" Click="RegisterButton_Click"/><TextBlock x:Name="RegistrationErrorTextBlock" Visibility="Collapsed" Foreground="#FF7A7A" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="Already have an account?" HorizontalAlignment="Center" Foreground="#9FA4AE" Margin="0,22,0,4"/><Button Content="Back to sign in" Height="38" Style="{StaticResource GlassBackButton}" Click="BackToLoginButton_Click"/>
        </StackPanel></Border></Grid></ScrollViewer>
    </Grid>
</UserControl>
