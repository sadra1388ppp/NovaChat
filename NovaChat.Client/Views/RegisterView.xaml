<UserControl x:Class="NovaChat.Client.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#0F1115">
    <UserControl.Resources>
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#66D4A373"/>
            <Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Box"
                                    CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="FocusGlow"
                                    CornerRadius="14"
                                    BorderBrush="#00D4A373"
                                    BorderThickness="1"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#90FFFFFF"/>
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#45D4A373"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFD4A373"/>
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#90D4A373"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Box"
                                    CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="FocusGlow"
                                    CornerRadius="14"
                                    BorderBrush="#00D4A373"
                                    BorderThickness="1"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#90FFFFFF"/>
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#45D4A373"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFD4A373"/>
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#90D4A373"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="154"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E2126"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D9DDE4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="GlassCreateButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#D4A373"/>
            <Setter Property="BorderBrush" Value="#E8C79C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border CornerRadius="15" Margin="1" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E5B98E"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFF4E6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#B98253"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassBackButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#D4A373"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Padding="10,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#25D4A373"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E6EA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="DuplicateWarning" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7A7A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="PhoneHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9EA5B1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F1115">
        <Border IsHitTestVisible="False" Opacity="0.55">
            <Border.Background>
                <RadialGradientBrush Center="0.22,0.40" GradientOrigin="0.22,0.40" RadiusX="0.72" RadiusY="0.82">
                    <GradientStop Color="#35FFD66E" Offset="0"/>
                    <GradientStop Color="#14FFD66E" Offset="0.35"/>
                    <GradientStop Color="#00FFD66E" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="820" Margin="24,34">
                <Border Width="560"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1CFFFFFF"
                        BorderBrush="#3AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="30">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="12" Opacity="0.38"/>
                    </Border.Effect>

                    <StackPanel>
                        <Border Width="64" Height="64" CornerRadius="20" Background="#D4A373" HorizontalAlignment="Center">
                            <TextBlock Text="N" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Create your NovaChat account"
                                   FontSize="29"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,7"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Set up your profile and start chatting in one place."
                                   FontSize="13"
                                   Foreground="#BFC3CA"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,26"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameTextBox" Style="{StaticResource GlassTextBox}" Height="48" TextChanged="UsernameTextBox_TextChanged"/>
                        <TextBlock x:Name="UsernameDuplicateText" Text="This username is already taken." Style="{StaticResource DuplicateWarning}"/>
                        <TextBlock Text="Use 3–32 letters, numbers, dot, underscore or hyphen."
                                   Foreground="#9097A3"
                                   FontSize="10.5"
                                   Margin="0,5,0,15"/>

                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource GlassPasswordBox}" Height="48" Margin="0,0,0,15"/>

                        <TextBlock Text="Display Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DisplayNameTextBox" Style="{StaticResource GlassTextBox}" Height="48" Margin="0,0,0,15"/>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EmailTextBox" Style="{StaticResource GlassTextBox}" Height="48" TextChanged="EmailTextBox_TextChanged"/>
                        <TextBlock x:Name="EmailDuplicateText" Text="This email is already registered." Style="{StaticResource DuplicateWarning}"/>
                        <Border Height="15" Background="Transparent"/>

                        <TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="PhoneNumberTextBox"
                                     Style="{StaticResource GlassTextBox}"
                                     Height="48"
                                     PreviewTextInput="PhoneNumberTextBox_PreviewTextInput"
                                     TextChanged="PhoneNumberTextBox_TextChanged"
                                     DataObject.Pasting="PhoneNumberTextBox_Pasting"/>
                            <TextBlock x:Name="PhoneHintText" Text="09987654321" Style="{StaticResource PhoneHint}"/>
                        </Grid>
                        <TextBlock x:Name="PhoneDuplicateText" Text="This phone number is already registered." Style="{StaticResource DuplicateWarning}"/>
                        <TextBlock x:Name="PhoneValidationText" Text="Phone number must contain exactly 11 digits and start with 0." Style="{StaticResource DuplicateWarning}"/>

                        <TextBlock Text="Privacy" Foreground="#E4E6EA" FontSize="12" FontWeight="SemiBold" Margin="0,21,0,9"/>
                        <Border Padding="14"
                                Background="#15FFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="15"
                                Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Who can message me?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Choose whether new people can start chats directly or need your approval."
                                               FontSize="10.5"
                                               Foreground="#BFC3CA"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="RegistrationMessagePrivacyBox"
                                          Style="{StaticResource GlassComboBox}"
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Everybody"/>
                                    <ComboBoxItem Content="Requests only"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Padding="14"
                                Background="#15FFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="15">
                            <CheckBox x:Name="RegistrationAllowGroupAddsBox"
                                      IsChecked="True"
                                      Foreground="#FFFFFF">
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Allow other people to add me to groups" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Turn this off to prevent direct group additions."
                                               FontSize="10.5"
                                               Foreground="#BFC3CA"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock x:Name="RegistrationErrorTextBlock"
                                   Visibility="Collapsed"
                                   Foreground="#FF7A7A"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,17,0,0"/>
                        <TextBlock x:Name="RegistrationSuccessTextBlock"
                                   Visibility="Collapsed"
                                   Foreground="#89E6A7"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,17,0,0"/>

                        <Button x:Name="RegisterButton"
                                Content="Create account"
                                Height="52"
                                Margin="0,18,0,0"
                                Style="{StaticResource GlassCreateButton}"
                                IsDefault="True"
                                Click="RegisterButton_Click"/>

                        <TextBlock Text="Already have an account?"
                                   HorizontalAlignment="Center"
                                   Foreground="#9FA4AE"
                                   Margin="0,22,0,4"/>
                        <Button Content="Back to sign in"
                                Height="38"
                                Style="{StaticResource GlassBackButton}"
                                Click="BackToLoginButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
