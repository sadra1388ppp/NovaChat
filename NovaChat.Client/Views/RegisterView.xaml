<UserControl x:Class="NovaChat.Client.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource AppBackgroundBrush}" MinHeight="700">
            <Border Width="500" Padding="42" Margin="32" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="17" Background="{DynamicResource PrimaryBrush}"><TextBlock Text="N" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </StackPanel>
                    <TextBlock Text="Create your NovaChat account" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Text="Everything you need to start chatting in one place." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,28" TextWrapping="Wrap"/>

                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                    <TextBox x:Name="UserIdTextBox" Height="46" Margin="0,0,0,13"/>
                    <TextBlock Text="Display Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                    <TextBox x:Name="DisplayNameTextBox" Height="46" Margin="0,0,0,13"/>
                    <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                    <TextBox x:Name="EmailTextBox" Height="46" Margin="0,0,0,13"/>
                    <TextBlock Text="Phone Number" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                    <TextBox x:Name="PhoneNumberTextBox" Height="46" Margin="0,0,0,13"/>
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                    <PasswordBox x:Name="PasswordBox" Height="46" Margin="0,0,0,21"/>
                    <Button x:Name="RegisterButton" Content="Create account" Height="50" FontSize="15" Style="{StaticResource PrimaryButtonStyle}" Click="RegisterButton_Click"/>
                    <TextBlock Text="Already have an account?" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,22,0,4"/>
                    <Button Content="Back to sign in" Height="38" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource PrimaryBrush}" Click="BackToLoginButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>