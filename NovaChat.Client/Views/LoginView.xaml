<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#07080C">
    <Grid x:Name="LoginRoot" Background="#07080C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="18" ShadowDepth="5" Opacity="0.55" />
        </Grid.Resources>

        <Border x:Name="WarmLightOverlay"
                Grid.ColumnSpan="2"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.23,0.28"
                                     GradientOrigin="0.23,0.28"
                                     RadiusX="0.72"
                                     RadiusY="0.78">
                    <GradientStop Color="#FFFFE7A0" Offset="0" />
                    <GradientStop Color="#FFF5C85B" Offset="0.20" />
                    <GradientStop Color="#8CD59D43" Offset="0.48" />
                    <GradientStop Color="#00D59D43" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="0" MinWidth="420">
            <Canvas x:Name="LampCanvas"
                    Width="500"
                    Height="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    MouseMove="LampCanvas_MouseMove"
                    MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">

                <Ellipse x:Name="LampGlow"
                         Width="430"
                         Height="430"
                         Canvas.Left="35"
                         Canvas.Top="18"
                         IsHitTestVisible="False"
                         Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF8D6" Offset="0" />
                            <GradientStop Color="#FFF5D36A" Offset="0.22" />
                            <GradientStop Color="#55E4B94D" Offset="0.52" />
                            <GradientStop Color="#00E4B94D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path x:Name="SuspensionWire"
                      Stroke="#41434B"
                      StrokeThickness="3"
                      Data="M 250,0 L 250,105"
                      IsHitTestVisible="False" />

                <Canvas x:Name="LampAssembly"
                        Width="210"
                        Height="180"
                        Canvas.Left="145"
                        Canvas.Top="86"
                        RenderTransformOrigin="0.5,0"
                        Effect="{StaticResource LampShadow}">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>

                    <!-- ceiling hook -->
                    <Ellipse Width="24"
                             Height="24"
                             Canvas.Left="93"
                             Canvas.Top="0"
                             Fill="#292B33"
                             Stroke="#696B73"
                             StrokeThickness="2" />
                    <Ellipse Width="9"
                             Height="9"
                             Canvas.Left="100.5"
                             Canvas.Top="7"
                             Fill="#111218" />
                    <Rectangle Width="8"
                               Height="20"
                               Canvas.Left="101"
                               Canvas.Top="19"
                               RadiusX="3"
                               RadiusY="3"
                               Fill="#464850" />

                    <!-- realistic metal shade -->
                    <Path Data="M 23,34 Q 105,2 187,34 L 162,119 Q 151,145 105,153 Q 59,145 48,119 Z"
                          Fill="#1D1F26"
                          Stroke="#696B74"
                          StrokeThickness="3" />
                    <Path Data="M 30,34 Q 105,10 180,34"
                          Stroke="#999BA1"
                          StrokeThickness="3"
                          Opacity="0.48"
                          IsHitTestVisible="False" />
                    <Path Data="M 45,52 Q 105,29 165,52"
                          Stroke="#44464E"
                          StrokeThickness="2"
                          Opacity="0.8"
                          IsHitTestVisible="False" />
                    <Path Data="M 52,60 L 69,118 Q 105,141 141,118 L 158,60"
                          Stroke="#30323A"
                          StrokeThickness="2"
                          Fill="Transparent"
                          IsHitTestVisible="False" />

                    <!-- warm inner reflector -->
                    <Path x:Name="LampReflector"
                          Data="M 51,111 Q 105,94 159,111 Q 151,145 105,154 Q 59,145 51,111 Z"
                          Fill="#282A31"
                          Stroke="#70727B"
                          StrokeThickness="2" />

                    <!-- bulb and socket -->
                    <Rectangle Width="30"
                               Height="22"
                               Canvas.Left="90"
                               Canvas.Top="76"
                               RadiusX="4"
                               RadiusY="4"
                               Fill="#464850"
                               Stroke="#74767D"
                               StrokeThickness="1.5" />
                    <Ellipse x:Name="LampBulbGlow"
                             Width="66"
                             Height="66"
                             Canvas.Left="72"
                             Canvas.Top="83"
                             Fill="#FFF3A6"
                             Opacity="0.05"
                             IsHitTestVisible="False" />
                    <Ellipse x:Name="LampBulb"
                             Width="42"
                             Height="42"
                             Canvas.Left="84"
                             Canvas.Top="88"
                             Fill="#41434D"
                             Stroke="#898B92"
                             StrokeThickness="2" />
                    <Ellipse Width="24"
                             Height="24"
                             Canvas.Left="93"
                             Canvas.Top="97"
                             Fill="#555761"
                             Opacity="0.65"
                             IsHitTestVisible="False" />

                    <!-- lower rim -->
                    <Ellipse x:Name="LampShadeGlow"
                             Width="112"
                             Height="30"
                             Canvas.Left="49"
                             Canvas.Top="105"
                             Fill="#1A1B21"
                             Stroke="#777983"
                             StrokeThickness="2.5" />
                    <Ellipse Width="91"
                             Height="16"
                             Canvas.Left="59.5"
                             Canvas.Top="112"
                             Fill="#0E0F14"
                             Opacity="0.65"
                             IsHitTestVisible="False" />
                </Canvas>

                <!-- cord remains directly attached to the lamp -->
                <Path x:Name="PullCord"
                      Stroke="#AFA17D"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />

                <Ellipse x:Name="LampPull"
                         Width="25"
                         Height="25"
                         Canvas.Left="237.5"
                         Canvas.Top="350"
                         Fill="#AFA16F"
                         Stroke="#E8D99C"
                         StrokeThickness="2"
                         Cursor="Hand"
                         MouseLeftButtonDown="LampPull_MouseLeftButtonDown" />

                <!-- welcome copy is intentionally at the bottom; no pull hint -->
                <StackPanel Canvas.Left="50"
                            Canvas.Top="485"
                            Width="400"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="WelcomeText"
                               Text="Welcome to NovaChat"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#E9E9ED"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeSubText"
                               Text="Pull the light. Sign in. Get back to your conversations."
                               FontSize="14"
                               Foreground="#6E707A"
                               Margin="0,9,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Canvas>
        </Grid>

        <Grid Grid.Column="1"
              Margin="42,30,58,30"
              MaxWidth="430"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="LoginCard"
                    Background="#12141B"
                    BorderBrush="#292C36"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="34">
                <Border.Effect>
                    <DropShadowEffect x:Name="LoginCardShadow"
                                      BlurRadius="28"
                                      ShadowDepth="8"
                                      Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="SignInTitle"
                               Text="Sign in"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#E9E9ED" />
                    <TextBlock x:Name="SignInSubtitle"
                               Text="Continue to your NovaChat account"
                               FontSize="14"
                               Foreground="#777983"
                               Margin="0,6,0,28" />

                    <TextBlock Text="User ID"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858792"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="UserIdTextBox"
                             Height="48"
                             Margin="0,0,0,17" />

                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858792"
                               Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox"
                                 Height="48"
                                 Margin="0,0,0,22" />

                    <Button x:Name="LoginButton"
                            Content="Sign in"
                            Height="50"
                            FontSize="15"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoginButton_Click" />

                    <TextBlock Text="Don't have an account?"
                               HorizontalAlignment="Center"
                               Foreground="#777983"
                               Margin="0,23,0,4" />
                    <Button Content="Create a new account"
                            Height="38"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="#D6B94F"
                            Click="CreateAccountButton_Click" />

                    <TextBlock Text="Your credentials are protected by NovaChat authentication."
                               FontSize="11"
                               Foreground="#62646D"
                               TextAlignment="Center"
                               Margin="0,24,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>