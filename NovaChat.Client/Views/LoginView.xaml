<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#121417">
    <UserControl.Resources>
        <Style x:Key="GlassSignInButton" TargetType="Button">
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#D4A373" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="OuterGlass" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ButtonGlow" BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Border.Effect>
                                <Grid Clip="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Clip}">
                                    <Border x:Name="GlassTint" CornerRadius="15" Background="#00FFFFFF" BorderThickness="1" BorderBrush="#00FFFFFF" />
                                    <Border x:Name="TopReflection" CornerRadius="15" Margin="1" IsHitTestVisible="False" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#D9FFFFFF" Offset="0" />
                                                <GradientStop Color="#55FFFFFF" Offset="0.18" />
                                                <GradientStop Color="#12FFFFFF" Offset="0.52" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="Shine" Width="72" HorizontalAlignment="Left" Margin="-100,0,0,0" CornerRadius="18" Opacity="0" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ShineTransform" X="0" />
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#E8FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="InnerGlow" CornerRadius="14" Margin="2" BorderThickness="1" BorderBrush="#00FFFFFF" IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterGlass" Property="Background" Value="#66FFFFFF" />
                                <Setter TargetName="OuterGlass" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="GlassTint" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="GlassTint" Property="BorderBrush" Value="#80FFFFFF" />
                                <Setter TargetName="TopReflection" Property="Opacity" Value="1" />
                                <Setter TargetName="Shine" Property="Opacity" Value="0.95" />
                                <Setter TargetName="InnerGlow" Property="BorderBrush" Value="#55FFFFFF" />
                                <Setter TargetName="ButtonGlow" Property="BlurRadius" Value="32" />
                                <Setter TargetName="ButtonGlow" Property="Color" Value="#FFFFC77D" />
                                <Setter TargetName="ButtonGlow" Property="Opacity" Value="0.9" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ShineTransform" Storyboard.TargetProperty="X" From="-20" To="430" Duration="0:0:0.65" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterGlass" Property="Background" Value="#A8FFFFFF" />
                                <Setter TargetName="OuterGlass" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="GlassTint" Property="Background" Value="#50FFFFFF" />
                                <Setter TargetName="ButtonGlow" Property="BlurRadius" Value="18" />
                                <Setter TargetName="ButtonScale" Property="ScaleX" Value="0.985" />
                                <Setter TargetName="ButtonScale" Property="ScaleY" Value="0.985" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterGlass" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LoginRoot" Background="#121417">
        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
        </Grid.Resources>
        <Border x:Name="WarmLightOverlay" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.30,0.40" GradientOrigin="0.30,0.40" RadiusX="0.58" RadiusY="0.68">
                    <GradientStop Color="#FFFFF3B8" Offset="0" />
                    <GradientStop Color="#70FFD66E" Offset="0.22" />
                    <GradientStop Color="#28FFD66E" Offset="0.48" />
                    <GradientStop Color="#00FFD66E" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Grid Margin="35,0,35,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="420" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="LampCanvas" Width="420" Height="500" Background="Transparent" MouseMove="LampCanvas_MouseMove" MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">
                    <Canvas.RenderTransform>
                        <TranslateTransform Y="-42.8" />
                    </Canvas.RenderTransform>
                    <Ellipse x:Name="LampGlow" Width="370" Height="370" Canvas.Left="30" Canvas.Top="35" IsHitTestVisible="False" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFFF8D6" Offset="0" />
                                <GradientStop Color="#FFFFDB8A" Offset="0.20" />
                                <GradientStop Color="#45FFD66E" Offset="0.50" />
                                <GradientStop Color="#00FFD66E" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Canvas x:Name="LampAssembly" Width="244" Height="366" Canvas.Left="128" Canvas.Top="104.8" RenderTransformOrigin="0.5,0.36" Effect="{StaticResource LampShadow}">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                        </Canvas.RenderTransform>
                        <Rectangle Width="19.5" Height="195.2" Canvas.Left="112.2" Canvas.Top="122" RadiusX="9.75" RadiusY="9.75" Fill="#D1CCC2" />
                        <Rectangle Width="97.6" Height="14.6" Canvas.Left="73.2" Canvas.Top="305" RadiusX="7.3" RadiusY="7.3" Fill="#D1CCC2" />
                        <Path x:Name="LampBulb" Data="M 36.6,134.2 C 36.6,61 207.4,61 207.4,134.2 C 207.4,152.5 36.6,152.5 36.6,134.2 Z" Fill="#F5F0E6" />
                        <Path x:Name="LampShadeGlow" Data="M 36.6,134.2 C 36.6,61 207.4,61 207.4,134.2 C 207.4,152.5 36.6,152.5 36.6,134.2 Z" Fill="#FFFFFF" Opacity="0.04" IsHitTestVisible="False" />
                        <Ellipse x:Name="LampBulbGlow" Width="146.4" Height="73.2" Canvas.Left="48.8" Canvas.Top="92.7" Fill="#FFDB8A" Opacity="0" IsHitTestVisible="False" />
                        <Path x:Name="LampReflector" Data="M 0,0 L 0,0" Fill="#282A31" Opacity="0" IsHitTestVisible="False" />
                    </Canvas>
                    <Path x:Name="PullCord" Stroke="#555555" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                    <Ellipse x:Name="LampPull" Width="15" Height="15" Canvas.Left="322.5" Canvas.Top="342.5" Fill="#D4A373" Stroke="#E8C79C" StrokeThickness="1" Cursor="Hand" MouseLeftButtonDown="LampPull_MouseLeftButtonDown" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LampPullTransform" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel Canvas.Left="15" Canvas.Top="20" Width="350" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="WelcomeText" Text="Welcome to NovaChat" FontSize="25" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" />
                        <TextBlock x:Name="WelcomeSubText" Text="Pull the light to continue" FontSize="12" Foreground="#8D9299" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Canvas>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="390" Margin="0,0,25,0">
                <Border x:Name="LoginCard" Background="#0D0F13" BorderBrush="#FFFFFF1A" BorderThickness="1" CornerRadius="30" Padding="32" Opacity="0" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect x:Name="LoginCardShadow" BlurRadius="40" ShadowDepth="18" Opacity="0.3" /></Border.Effect>
                    <Grid>
                        <Border CornerRadius="28" Margin="-31" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38FFFFFF" Offset="0" />
                                    <GradientStop Color="#18FFFFFF" Offset="0.28" />
                                    <GradientStop Color="#08FFFFFF" Offset="0.60" />
                                    <GradientStop Color="#20D4A373" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="27" Margin="-30" BorderThickness="1" BorderBrush="#55FFFFFF" IsHitTestVisible="False" />
                        <Border CornerRadius="24" Height="90" VerticalAlignment="Top" Margin="-5,-5,-5,0" IsHitTestVisible="False" Opacity="0.8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#48FFFFFF" Offset="0" />
                                    <GradientStop Color="#10FFFFFF" Offset="0.45" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="SignInTitle" Text="Welcome to NovaChat" FontSize="25" FontWeight="Medium" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,25" />
                            <TextBlock Text="User ID" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                            <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,18" Background="#12FFFFFF" Foreground="#FFFFFF" BorderBrush="#12FFFFFF" Padding="14,0" VerticalContentAlignment="Center" />
                            <TextBlock Text="Password" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                            <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,20" Background="#12FFFFFF" Foreground="#FFFFFF" BorderBrush="#12FFFFFF" Padding="14,0" VerticalContentAlignment="Center" />
                            <Button x:Name="LoginButton" Content="Sign In" Height="50" Click="LoginButton_Click" Style="{StaticResource GlassSignInButton}" />
                            <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account" FontSize="11" Foreground="#777777" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <Button Content="Create a new account" Height="36" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="#D4A373" Click="CreateAccountButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>