<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#07080C">
    <Grid x:Name="LoginRoot" Background="#07080C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <!-- Warm light that appears from the lamp instead of a flat screen tint. -->
        <Border x:Name="WarmLightOverlay"
                Grid.ColumnSpan="2"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.23,0.28"
                                     GradientOrigin="0.23,0.28"
                                     RadiusX="0.72"
                                     RadiusY="0.78">
                    <GradientStop Color="#FFFFE7A0" Offset="0" />
                    <GradientStop Color="#FFF5C85B" Offset="0.20" />
                    <GradientStop Color="#8CD59D43" Offset="0.48" />
                    <GradientStop Color="#00D59D43" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Left hero area: the lamp is free-standing, with no blue panel around it. -->
        <Grid Grid.Column="0" MinWidth="420">
            <Canvas x:Name="LampCanvas"
                    Width="500"
                    Height="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    MouseMove="LampCanvas_MouseMove"
                    MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">

                <!-- Soft pool of light around the lamp. -->
                <Ellipse x:Name="LampGlow"
                         Width="360"
                         Height="360"
                         Canvas.Left="70"
                         Canvas.Top="65"
                         IsHitTestVisible="False"
                         Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF1AE" Offset="0" />
                            <GradientStop Color="#FFF5CF62" Offset="0.28" />
                            <GradientStop Color="#40E4B94D" Offset="0.58" />
                            <GradientStop Color="#00E4B94D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Main suspension wire. -->
                <Path x:Name="SuspensionWire"
                      Stroke="#4B4D56"
                      StrokeThickness="3"
                      Data="M 250,0 L 250,108"
                      IsHitTestVisible="False" />

                <!-- Lamp body + small transform so it can naturally sway. -->
                <Canvas x:Name="LampAssembly"
                        Width="170"
                        Height="155"
                        Canvas.Left="165"
                        Canvas.Top="92"
                        RenderTransformOrigin="0.5,0">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>

                    <Ellipse Width="20"
                             Height="20"
                             Canvas.Left="75"
                             Canvas.Top="0"
                             Fill="#3F414A" />

                    <Path Data="M 35,27 Q 85,5 135,27 L 118,104 Q 85,132 52,104 Z"
                          Fill="#242630"
                          Stroke="#565865"
                          StrokeThickness="3" />

                    <Ellipse x:Name="LampShadeGlow"
                             Width="76"
                             Height="23"
                             Canvas.Left="47"
                             Canvas.Top="91"
                             Fill="#1D1E25"
                             Stroke="#5D5E68"
                             StrokeThickness="2" />

                    <Ellipse x:Name="LampBulb"
                             Width="38"
                             Height="38"
                             Canvas.Left="66"
                             Canvas.Top="74"
                             Fill="#454751"
                             Stroke="#777986"
                             StrokeThickness="2" />
                </Canvas>

                <!-- Pull cord starts directly underneath the lamp. -->
                <Path x:Name="PullCord"
                      Stroke="#B7A985"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />

                <Ellipse x:Name="LampPull"
                         Width="24"
                         Height="24"
                         Canvas.Left="238"
                         Canvas.Top="350"
                         Fill="#B9A96F"
                         Stroke="#F1E1A5"
                         StrokeThickness="2"
                         Cursor="Hand"
                         MouseLeftButtonDown="LampPull_MouseLeftButtonDown" />

                <TextBlock x:Name="PullHint"
                           Text="pull the cord"
                           Canvas.Left="196"
                           Canvas.Top="386"
                           Width="108"
                           TextAlignment="Center"
                           FontSize="13"
                           Foreground="#777983"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="WelcomeText"
                           Text="Welcome to NovaChat"
                           Canvas.Left="65"
                           Canvas.Top="465"
                           Width="370"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#E9E9ED"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="WelcomeSubText"
                           Text="Pull the light. Sign in. Get back to your conversations."
                           Canvas.Left="70"
                           Canvas.Top="523"
                           Width="360"
                           FontSize="14"
                           Foreground="#6E707A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />
            </Canvas>
        </Grid>

        <!-- Login card remains functionally identical, but emerges from the dark. -->
        <Grid Grid.Column="1"
              Margin="42,30,58,30"
              MaxWidth="430"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="LoginCard"
                    Background="#12141B"
                    BorderBrush="#292C36"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="34">
                <StackPanel>
                    <TextBlock x:Name="SignInTitle"
                               Text="Sign in"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#E9E9ED" />
                    <TextBlock x:Name="SignInSubtitle"
                               Text="Continue to your NovaChat account"
                               FontSize="14"
                               Foreground="#777983"
                               Margin="0,6,0,28" />

                    <TextBlock Text="User ID"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858792"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="UserIdTextBox"
                             Height="48"
                             Margin="0,0,0,17" />

                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858792"
                               Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox"
                                 Height="48"
                                 Margin="0,0,0,22" />

                    <Button x:Name="LoginButton"
                            Content="Sign in"
                            Height="50"
                            FontSize="15"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoginButton_Click" />

                    <TextBlock Text="Don't have an account?"
                               HorizontalAlignment="Center"
                               Foreground="#777983"
                               Margin="0,23,0,4" />
                    <Button Content="Create a new account"
                            Height="38"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="#D6B94F"
                            Click="CreateAccountButton_Click" />

                    <TextBlock Text="Your credentials are protected by NovaChat authentication."
                               FontSize="11"
                               Foreground="#62646D"
                               TextAlignment="Center"
                               Margin="0,24,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>