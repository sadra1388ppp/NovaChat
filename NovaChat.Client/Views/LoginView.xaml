<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#121417">
    <Grid x:Name="LoginRoot" Background="#121417">
        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
        </Grid.Resources>

        <!-- Ambient light, matching the warm radial illumination of the reference. -->
        <Border x:Name="WarmLightOverlay" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.37,0.42" GradientOrigin="0.37,0.42" RadiusX="0.68" RadiusY="0.68">
                    <GradientStop Color="#66FFD66E" Offset="0" />
                    <GradientStop Color="#32FFD66E" Offset="0.28" />
                    <GradientStop Color="#10FFD66E" Offset="0.55" />
                    <GradientStop Color="#00FFD66E" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="36" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Coding Stella-style lamp -->
            <Grid Grid.Column="0" Width="300" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="LampCanvas" Width="300" Height="420"
                        Background="Transparent"
                        MouseMove="LampCanvas_MouseMove"
                        MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">

                    <Ellipse x:Name="LampGlow" Width="285" Height="250" Canvas.Left="7.5" Canvas.Top="22"
                             IsHitTestVisible="False" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFFF8D6" Offset="0" />
                                <GradientStop Color="#FFFFDB8A" Offset="0.22" />
                                <GradientStop Color="#45FFD66E" Offset="0.52" />
                                <GradientStop Color="#00FFD66E" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- The vertical lamp stem -->
                    <Rectangle x:Name="SuspensionWire" Width="7" Height="162" Canvas.Left="146.5" Canvas.Top="92"
                               RadiusX="3.5" RadiusY="3.5" Fill="#D1CCC2" IsHitTestVisible="False" />

                    <Canvas x:Name="LampAssembly" Width="200" Height="190" Canvas.Left="50" Canvas.Top="8"
                            RenderTransformOrigin="0.5,0.18" Effect="{StaticResource LampShadow}">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                        </Canvas.RenderTransform>

                        <!-- Inner warm glow -->
                        <Ellipse x:Name="LampReflector" Width="120" Height="58" Canvas.Left="40" Canvas.Top="76"
                                 Fill="#FFDB8A" Opacity="0" IsHitTestVisible="False" />

                        <!-- Lamp shade: intentionally broad and simple, like the reference SVG -->
                        <Path Data="M 15,105 C 15,45 185,45 185,105 C 185,120 15,120 15,105 Z"
                              Fill="#F5F0E6" Stroke="#D1CCC2" StrokeThickness="1.4" />

                        <!-- Soft inner highlight -->
                        <Ellipse x:Name="LampBulbGlow" Width="118" Height="48" Canvas.Left="41" Canvas.Top="81"
                                 Fill="#FFDB8A" Opacity="0.02" IsHitTestVisible="False" />

                        <!-- Small underside line for the shade -->
                        <Path Data="M 18,105 C 50,114 150,114 182,105"
                              Stroke="#C9C3B8" StrokeThickness="1.4" Opacity="0.75" IsHitTestVisible="False" />

                        <!-- Pull cord starts beside the shade -->
                    </Canvas>

                    <Path x:Name="PullCord"
                          Stroke="#555555"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          IsHitTestVisible="False" />

                    <!-- Circular pull bead: kept exactly as requested -->
                    <Ellipse x:Name="LampPull" Width="20" Height="20" Canvas.Left="140" Canvas.Top="278"
                             Fill="#D4A373" Stroke="#F0D0A5" StrokeThickness="1.2"
                             Cursor="Hand"
                             MouseLeftButtonDown="LampPull_MouseLeftButtonDown"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LampPullTransform" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <StackPanel Canvas.Left="20" Canvas.Top="338" Width="260" IsHitTestVisible="False">
                        <TextBlock x:Name="WelcomeText" Text="Welcome to NovaChat"
                                   FontSize="25" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextAlignment="Center" />
                        <TextBlock x:Name="WelcomeSubText"
                                   Text="Pull the light. Sign in. Get back to your conversations."
                                   FontSize="12" Foreground="#8D9299" Margin="0,7,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Canvas>
            </Grid>

            <!-- Glass login form, initially hidden just like the reference. -->
            <Grid Grid.Column="1" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="LoginCard"
                        Background="#0D0F13"
                        BorderBrush="#FFFFFF1A"
                        BorderThickness="1"
                        CornerRadius="30"
                        Padding="30"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect x:Name="LoginCardShadow" BlurRadius="40" ShadowDepth="18" Opacity="0.3" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="SignInTitle" Text="Welcome" FontSize="25" FontWeight="Medium"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,25" />

                        <TextBlock Text="User ID" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                        <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,18"
                                 Background="#12FFFFFF" Foreground="#FFFFFF"
                                 BorderBrush="#12FFFFFF" Padding="14,0" VerticalContentAlignment="Center" />

                        <TextBlock Text="Password" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                        <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,20"
                                     Background="#12FFFFFF" Foreground="#FFFFFF"
                                     BorderBrush="#12FFFFFF" Padding="14,0" VerticalContentAlignment="Center" />

                        <Button x:Name="LoginButton" Content="Sign In" Height="50" FontSize="15"
                                Background="#D4A373" Foreground="#121417" BorderThickness="0"
                                Click="LoginButton_Click" />

                        <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account"
                                   FontSize="11" Foreground="#777777" HorizontalAlignment="Center"
                                   Margin="0,18,0,0" />

                        <Button Content="Create a new account" Height="36" Margin="0,8,0,0"
                                Background="Transparent" BorderThickness="0" Foreground="#D4A373"
                                Click="CreateAccountButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>