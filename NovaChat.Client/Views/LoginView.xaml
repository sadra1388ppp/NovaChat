<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="34" CornerRadius="28" Background="{DynamicResource PrimaryBrush}">
            <Grid Margin="54">
                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                    <Border Width="64" Height="64" CornerRadius="20" Background="#25FFFFFF" Margin="0,0,0,22"><TextBlock Text="N" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Welcome to NovaChat" FontSize="38" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="A modern, private place for your conversations." FontSize="17" Foreground="#E9EAFF" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,32,0,0">
                        <TextBlock Text="REAL-TIME CHAT" FontSize="11" FontWeight="Bold" Foreground="#D9DCFF"/>
                        <TextBlock Text="Fast messages • Live presence • Clean conversations" FontSize="14" Foreground="White" Margin="0,7,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="48,32,70,32" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Sign in" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Continue to your NovaChat account" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,28"/>

                <TextBlock Text="User ID" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,17"/>
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,7"/>
                <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,22"/>

                <Button x:Name="LoginButton" Content="Sign in" Height="50" FontSize="15" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click"/>
                <TextBlock Text="Don't have an account?" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,23,0,4"/>
                <Button Content="Create a new account" Height="38" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource PrimaryBrush}" Click="CreateAccountButton_Click"/>
                <TextBlock Text="Your credentials are protected by NovaChat authentication." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" Margin="0,28,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>