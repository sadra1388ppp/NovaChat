<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#050608">
    <Grid x:Name="LoginRoot" Background="#050608">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="22" ShadowDepth="7" Opacity="0.58" />
        </Grid.Resources>

        <Border x:Name="WarmLightOverlay" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.23,0.25" GradientOrigin="0.23,0.25" RadiusX="0.72" RadiusY="0.78">
                    <GradientStop Color="#FFFFF0B0" Offset="0" />
                    <GradientStop Color="#FFF7D56A" Offset="0.18" />
                    <GradientStop Color="#72D59D43" Offset="0.44" />
                    <GradientStop Color="#00D59D43" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="0" MinWidth="420">
            <Canvas x:Name="LampCanvas" Width="500" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" MouseMove="LampCanvas_MouseMove" MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">
                <Ellipse x:Name="LampGlow" Width="470" Height="470" Canvas.Left="15" Canvas.Top="8" IsHitTestVisible="False" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF8D6" Offset="0" />
                            <GradientStop Color="#FFFFE18A" Offset="0.18" />
                            <GradientStop Color="#65E4B94D" Offset="0.48" />
                            <GradientStop Color="#00E4B94D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Minimal household ceiling cable and socket. -->
                <Path x:Name="SuspensionWire" Stroke="#383A41" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 250,0 L 250,92" IsHitTestVisible="False" />

                <Canvas x:Name="LampAssembly" Width="150" Height="180" Canvas.Left="175" Canvas.Top="72" RenderTransformOrigin="0.5,0" Effect="{StaticResource LampShadow}">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>

                    <!-- Simple real-world socket. -->
                    <Ellipse Width="42" Height="12" Canvas.Left="54" Canvas.Top="0" Fill="#17191F" Stroke="#777A82" StrokeThickness="1.3" />
                    <Rectangle Width="6" Height="24" Canvas.Left="72" Canvas.Top="7" RadiusX="3" RadiusY="3" Fill="#4D5058" />
                    <Rectangle Width="31" Height="31" Canvas.Left="59.5" Canvas.Top="27" RadiusX="7" RadiusY="7" Fill="#252830" Stroke="#696C74" StrokeThickness="1.2" />

                    <!-- Bare household bulb. No lampshade, no outer glass cover, no chandelier. -->
                    <Ellipse x:Name="LampBulbGlow" Width="126" Height="134" Canvas.Left="12" Canvas.Top="46" Fill="#FFF3A6" Opacity="0.025" IsHitTestVisible="False" />
                    <Path x:Name="LampBulb" Stroke="#B4B6BC" StrokeThickness="1.4" Data="M 49,49 C 49,39 58,34 75,34 C 92,34 101,39 101,49 C 101,62 98,70 103,84 C 108,98 111,111 106,123 C 101,138 90,148 75,151 C 60,148 49,138 44,123 C 39,111 42,98 47,84 C 52,70 49,62 49,49 Z">
                        <Path.Fill>
                            <RadialGradientBrush Center="0.5,0.52" RadiusX="0.62" RadiusY="0.68">
                                <GradientStop Color="#FFF9CC" Offset="0" />
                                <GradientStop Color="#FFF1B9" Offset="0.30" />
                                <GradientStop Color="#D8A94D" Offset="0.72" />
                                <GradientStop Color="#604B28" Offset="1" />
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- Small metal screw base below the bulb. -->
                    <Path x:Name="LampShadeGlow" Data="M 53,137 L 97,137 L 94,146 Q 75,153 56,146 Z" Fill="#24262D" Stroke="#85878E" StrokeThickness="1.3" />
                    <Path Data="M 57,140 L 93,140 M 58,144 L 92,144" Stroke="#85878E" StrokeThickness="1" Opacity="0.45" IsHitTestVisible="False" />

                    <!-- Tiny warm filament hint. -->
                    <Path Data="M 67,76 Q 75,68 83,76 L 79,106 Q 75,112 71,106 Z" Stroke="#FFF6BE" StrokeThickness="1.6" Opacity="0.7" IsHitTestVisible="False" />
                </Canvas>

                <!-- Loose, natural pull cord. The round pull remains perfectly circular. -->
                <Path x:Name="PullCord" Stroke="#9E947A" StrokeThickness="3.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                <Ellipse x:Name="LampPull" Width="22" Height="22" Canvas.Left="239" Canvas.Top="350" Fill="#AFA16F" Stroke="#E8D99C" StrokeThickness="1.8" Cursor="Hand" MouseLeftButtonDown="LampPull_MouseLeftButtonDown" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="LampPullTransform" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <StackPanel Canvas.Left="50" Canvas.Top="485" Width="400" IsHitTestVisible="False">
                    <TextBlock x:Name="WelcomeText" Text="Welcome to NovaChat" FontSize="32" FontWeight="Bold" Foreground="#E9E9ED" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeSubText" Text="Pull the light. Sign in. Get back to your conversations." FontSize="14" Foreground="#6E707A" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Canvas>
        </Grid>

        <Grid Grid.Column="1" Margin="42,30,58,30" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="LoginCard" Background="#12141B" BorderBrush="#292C36" BorderThickness="1" CornerRadius="24" Padding="34">
                <Border.Effect>
                    <DropShadowEffect x:Name="LoginCardShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="SignInTitle" Text="Sign in" FontSize="30" FontWeight="Bold" Foreground="#E9E9ED" />
                    <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account" FontSize="14" Foreground="#777983" Margin="0,6,0,28" />
                    <TextBlock Text="User ID" FontSize="12" FontWeight="SemiBold" Foreground="#858792" Margin="0,0,0,7" />
                    <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,17" />
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#858792" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,22" />
                    <Button x:Name="LoginButton" Content="Sign in" Height="50" FontSize="15" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" />
                    <TextBlock Text="Don't have an account?" HorizontalAlignment="Center" Foreground="#777983" Margin="0,23,0,4" />
                    <Button Content="Create a new account" Height="38" Style="{StaticResource GhostButtonStyle}" Foreground="#D6B94F" Click="CreateAccountButton_Click" />
                    <TextBlock Text="Your credentials are protected by NovaChat authentication." FontSize="11" Foreground="#62646D" TextAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>