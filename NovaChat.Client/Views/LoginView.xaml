<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#121417">
    <UserControl.Resources>
        <!-- Remove the default Windows blue hover/focus chrome from every login control. -->
        <Style x:Key="GlassSignInButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8F8F8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#D4A373" />
            <Setter Property="BorderBrush" Value="#D4A373" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonGlow" CornerRadius="16" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" Margin="-5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD7A66E" BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ButtonSurface" CornerRadius="16" Background="#D4A373" BorderBrush="#E8C79C" BorderThickness="1">
                                <Grid Clip="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Clip}">
                                    <Border CornerRadius="15" Margin="1" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" />
                                    <Border x:Name="ButtonTopGlass" CornerRadius="15" Margin="1" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CFFFFFFF" Offset="0" />
                                                <GradientStop Color="#45FFFFFF" Offset="0.22" />
                                                <GradientStop Color="#08FFFFFF" Offset="0.62" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="ButtonShine" Width="85" HorizontalAlignment="Left" Margin="-120,0,0,0" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-18" />
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#BFFFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E4B98D" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="ButtonTopGlass" Property="Opacity" Value="1" />
                                <Setter TargetName="ButtonGlow" Property="BorderThickness" Value="5" />
                                <Setter TargetName="ButtonGlow" Property="BorderBrush" Value="#50FFE4B0" />
                                <Setter TargetName="ButtonGlow" Property="Background" Value="#22FFE4B0" />
                                <Setter TargetName="ButtonGlow" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFFC979" BlurRadius="22" ShadowDepth="0" Opacity="0.9" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonShine" Property="Opacity" Value="0.8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonShine" Storyboard.TargetProperty="Margin" From="-120,0,0,0" To="390,0,-510,0" Duration="0:0:0.65" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#B98758" />
                                <Setter TargetName="ButtonScale" Property="ScaleX" Value="0.985" />
                                <Setter TargetName="ButtonScale" Property="ScaleY" Value="0.985" />
                                <Setter TargetName="ButtonTopGlass" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Box" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusGlow" CornerRadius="14" BorderBrush="#00FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#70FFFFFF" />
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#35D4A373" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BFD4A373" />
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#80D4A373" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Box" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusGlow" CornerRadius="14" BorderBrush="#00FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#70FFFFFF" />
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#35D4A373" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#25FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#BFD4A373" />
                                <Setter TargetName="FocusGlow" Property="BorderBrush" Value="#80D4A373" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateAccountButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D4A373" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CreateSurface" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CreateSurface" Property="Background" Value="#18D4A373" />
                                <Setter TargetName="CreateSurface" Property="BorderBrush" Value="#55D4A373" />
                                <Setter Property="Foreground" Value="#FFE6C9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CreateSurface" Property="Background" Value="#30D4A373" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LoginRoot" Background="#121417">
        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
        </Grid.Resources>
        <Border x:Name="WarmLightOverlay" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.30,0.40" GradientOrigin="0.30,0.40" RadiusX="0.58" RadiusY="0.68">
                    <GradientStop Color="#FFFFF3B8" Offset="0" />
                    <GradientStop Color="#70FFD66E" Offset="0.22" />
                    <GradientStop Color="#28FFD66E" Offset="0.48" />
                    <GradientStop Color="#00FFD66E" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Grid Margin="35,0,35,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="420" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="LampCanvas" Width="420" Height="500" Background="Transparent" MouseMove="LampCanvas_MouseMove" MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">
                    <Canvas.RenderTransform>
                        <TranslateTransform Y="-42.8" />
                    </Canvas.RenderTransform>
                    <Ellipse x:Name="LampGlow" Width="370" Height="370" Canvas.Left="30" Canvas.Top="35" IsHitTestVisible="False" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFFF8D6" Offset="0" />
                                <GradientStop Color="#FFFFDB8A" Offset="0.20" />
                                <GradientStop Color="#45FFD66E" Offset="0.50" />
                                <GradientStop Color="#00FFD66E" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Canvas x:Name="LampAssembly" Width="244" Height="366" Canvas.Left="128" Canvas.Top="104.8" RenderTransformOrigin="0.5,0.36" Effect="{StaticResource LampShadow}">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                        </Canvas.RenderTransform>
                        <Rectangle Width="19.5" Height="195.2" Canvas.Left="112.2" Canvas.Top="122" RadiusX="9.75" RadiusY="9.75" Fill="#D1CCC2" />
                        <Rectangle Width="97.6" Height="14.6" Canvas.Left="73.2" Canvas.Top="305" RadiusX="7.3" RadiusY="7.3" Fill="#D1CCC2" />
                        <Path x:Name="LampBulb" Data="M 36.6,134.2 C 36.6,61 207.4,61 207.4,134.2 C 207.4,152.5 36.6,152.5 36.6,134.2 Z" Fill="#F5F0E6" />
                        <Path x:Name="LampShadeGlow" Data="M 36.6,134.2 C 36.6,61 207.4,61 207.4,134.2 C 207.4,152.5 36.6,152.5 36.6,134.2 Z" Fill="#FFFFFF" Opacity="0.04" IsHitTestVisible="False" />
                        <Ellipse x:Name="LampBulbGlow" Width="146.4" Height="73.2" Canvas.Left="48.8" Canvas.Top="92.7" Fill="#FFDB8A" Opacity="0" IsHitTestVisible="False" />
                        <Path x:Name="LampReflector" Data="M 0,0 L 0,0" Fill="#282A31" Opacity="0" IsHitTestVisible="False" />
                    </Canvas>
                    <Path x:Name="PullCord" Stroke="#555555" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                    <Ellipse x:Name="LampPull" Width="15" Height="15" Canvas.Left="322.5" Canvas.Top="342.5" Fill="#D4A373" Stroke="#E8C79C" StrokeThickness="1" Cursor="Hand" MouseLeftButtonDown="LampPull_MouseLeftButtonDown" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LampPullTransform" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="390" Margin="0,0,25,0">
                <Border x:Name="LoginCard" Background="#1A1D22" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="30" Padding="32" Opacity="0" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect x:Name="LoginCardShadow" BlurRadius="40" ShadowDepth="18" Opacity="0.3" /></Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="SignInTitle" Text="Welcome to NovaChat" FontSize="25" FontWeight="Medium" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,25" />
                        <TextBlock Text="User ID" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                        <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,18" Style="{StaticResource GlassTextBox}" />
                        <TextBlock Text="Password" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                        <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,20" Style="{StaticResource GlassPasswordBox}" />
                        <Button x:Name="LoginButton" Content="Sign In" Height="50" Click="LoginButton_Click" Style="{StaticResource GlassSignInButton}" />
                        <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account" FontSize="11" Foreground="#777777" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <Button Content="Create a new account" Height="36" Margin="0,8,0,0" Click="CreateAccountButton_Click" Style="{StaticResource CreateAccountButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>