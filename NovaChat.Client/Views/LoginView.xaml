<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#07080C">
    <Grid x:Name="LoginRoot" Background="#07080C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="24" ShadowDepth="8" Opacity="0.65" />
        </Grid.Resources>

        <Border x:Name="WarmLightOverlay" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.23,0.28" GradientOrigin="0.23,0.28" RadiusX="0.72" RadiusY="0.78">
                    <GradientStop Color="#FFFFE7A0" Offset="0" />
                    <GradientStop Color="#FFF5C85B" Offset="0.20" />
                    <GradientStop Color="#8CD59D43" Offset="0.48" />
                    <GradientStop Color="#00D59D43" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="0" MinWidth="420">
            <Canvas x:Name="LampCanvas" Width="500" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" MouseMove="LampCanvas_MouseMove" MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">

                <Ellipse x:Name="LampGlow" Width="450" Height="450" Canvas.Left="25" Canvas.Top="0" IsHitTestVisible="False" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF8D6" Offset="0" />
                            <GradientStop Color="#FFF5D36A" Offset="0.22" />
                            <GradientStop Color="#55E4B94D" Offset="0.52" />
                            <GradientStop Color="#00E4B94D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path x:Name="SuspensionWire" Stroke="#41434B" StrokeThickness="3" Data="M 250,0 L 250,105" IsHitTestVisible="False" />

                <Canvas x:Name="LampAssembly" Width="250" Height="190" Canvas.Left="125" Canvas.Top="78" RenderTransformOrigin="0.5,0" Effect="{StaticResource LampShadow}">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>

                    <!-- premium ceiling canopy -->
                    <Ellipse Width="58" Height="20" Canvas.Left="96" Canvas.Top="0" Fill="#171920" Stroke="#73757D" StrokeThickness="2" />
                    <Ellipse Width="40" Height="12" Canvas.Left="105" Canvas.Top="4" Fill="#2E3038" Stroke="#989AA1" StrokeThickness="1" />
                    <Rectangle Width="12" Height="30" Canvas.Left="119" Canvas.Top="13" RadiusX="4" RadiusY="4" Fill="#34363E" />
                    <Ellipse Width="10" Height="7" Canvas.Left="121" Canvas.Top="31" Fill="#17181E" />

                    <!-- elegant suspension stem -->
                    <Rectangle Width="6" Height="28" Canvas.Left="122" Canvas.Top="37" RadiusX="3" RadiusY="3" Fill="#6C6E76" />
                    <Ellipse Width="14" Height="8" Canvas.Left="118" Canvas.Top="61" Fill="#202229" Stroke="#8C8E95" StrokeThickness="1.2" />

                    <!-- sculpted designer dome -->
                    <Path Data="M 28,67 Q 125,26 222,67 L 207,105 Q 195,143 166,158 Q 125,177 84,158 Q 55,143 43,105 Z" Stroke="#777982" StrokeThickness="2.5">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                                <GradientStop Color="#353740" Offset="0" />
                                <GradientStop Color="#1C1E25" Offset="0.42" />
                                <GradientStop Color="#101116" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- designer metal highlight -->
                    <Path Data="M 39,68 Q 125,34 211,68" Stroke="#B7B9BE" StrokeThickness="3" Opacity="0.42" IsHitTestVisible="False" />
                    <Path Data="M 54,76 Q 125,49 196,76" Stroke="#6F7179" StrokeThickness="2" Opacity="0.48" IsHitTestVisible="False" />
                    <Path Data="M 68,82 Q 125,63 182,82" Stroke="#D0D1D4" StrokeThickness="1" Opacity="0.16" IsHitTestVisible="False" />

                    <!-- warm inner reflector -->
                    <Path x:Name="LampReflector" Data="M 48,112 Q 125,91 202,112 Q 191,151 158,164 Q 125,176 92,164 Q 59,151 48,112 Z" Stroke="#7B7D84" StrokeThickness="2">
                        <Path.Fill>
                            <RadialGradientBrush Center="0.5,0.35">
                                <GradientStop Color="#555761" Offset="0" />
                                <GradientStop Color="#272932" Offset="0.65" />
                                <GradientStop Color="#17181F" Offset="1" />
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- premium brass accent ring -->
                    <Ellipse Width="154" Height="30" Canvas.Left="48" Canvas.Top="112" Fill="Transparent" Stroke="#8B7A43" StrokeThickness="5" />
                    <Ellipse Width="143" Height="21" Canvas.Left="53.5" Canvas.Top="116.5" Fill="#111218" Stroke="#C4AD62" StrokeThickness="1.5" />

                    <!-- exposed frosted LED bulb -->
                    <Rectangle Width="28" Height="22" Canvas.Left="111" Canvas.Top="77" RadiusX="4" RadiusY="4" Fill="#3D3F48" Stroke="#85878E" StrokeThickness="1.5" />
                    <Ellipse x:Name="LampBulbGlow" Width="88" Height="88" Canvas.Left="81" Canvas.Top="82" Fill="#FFF3A6" Opacity="0.05" IsHitTestVisible="False" />
                    <Ellipse x:Name="LampBulb" Width="50" Height="50" Canvas.Left="100" Canvas.Top="88" Fill="#454750" Stroke="#A0A2A8" StrokeThickness="2.2">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#666974" Offset="0" />
                                <GradientStop Color="#373943" Offset="0.65" />
                                <GradientStop Color="#22242C" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="30" Height="30" Canvas.Left="110" Canvas.Top="98" Fill="#777A83" Opacity="0.42" IsHitTestVisible="False" />
                    <Path Data="M 117,104 L 125,96 L 133,104 M 117,111 L 125,103 L 133,111 M 117,118 L 125,110 L 133,118" Stroke="#D7D8DA" StrokeThickness="1.2" Opacity="0.34" IsHitTestVisible="False" />

                    <!-- lower luminous aperture -->
                    <Ellipse x:Name="LampShadeGlow" Width="128" Height="31" Canvas.Left="61" Canvas.Top="119" Fill="#1A1B21" Stroke="#8C8E95" StrokeThickness="2.5" />
                    <Ellipse Width="104" Height="18" Canvas.Left="73" Canvas.Top="125" Fill="#090A0E" Opacity="0.72" IsHitTestVisible="False" />
                    <Ellipse Width="76" Height="10" Canvas.Left="87" Canvas.Top="129" Fill="#050609" Opacity="0.88" IsHitTestVisible="False" />
                </Canvas>

                <Path x:Name="PullCord" Stroke="#AFA17D" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />

                <Ellipse x:Name="LampPull" Width="25" Height="25" Canvas.Left="237.5" Canvas.Top="350" Fill="#AFA16F" Stroke="#E8D99C" StrokeThickness="2" Cursor="Hand" MouseLeftButtonDown="LampPull_MouseLeftButtonDown" />

                <StackPanel Canvas.Left="50" Canvas.Top="485" Width="400" IsHitTestVisible="False">
                    <TextBlock x:Name="WelcomeText" Text="Welcome to NovaChat" FontSize="32" FontWeight="Bold" Foreground="#E9E9ED" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeSubText" Text="Pull the light. Sign in. Get back to your conversations." FontSize="14" Foreground="#6E707A" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Canvas>
        </Grid>

        <Grid Grid.Column="1" Margin="42,30,58,30" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="LoginCard" Background="#12141B" BorderBrush="#292C36" BorderThickness="1" CornerRadius="24" Padding="34">
                <Border.Effect>
                    <DropShadowEffect x:Name="LoginCardShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="SignInTitle" Text="Sign in" FontSize="30" FontWeight="Bold" Foreground="#E9E9ED" />
                    <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account" FontSize="14" Foreground="#777983" Margin="0,6,0,28" />
                    <TextBlock Text="User ID" FontSize="12" FontWeight="SemiBold" Foreground="#858792" Margin="0,0,0,7" />
                    <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,17" />
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#858792" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,22" />
                    <Button x:Name="LoginButton" Content="Sign in" Height="50" FontSize="15" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" />
                    <TextBlock Text="Don't have an account?" HorizontalAlignment="Center" Foreground="#777983" Margin="0,23,0,4" />
                    <Button Content="Create a new account" Height="38" Style="{StaticResource GhostButtonStyle}" Foreground="#D6B94F" Click="CreateAccountButton_Click" />
                    <TextBlock Text="Your credentials are protected by NovaChat authentication." FontSize="11" Foreground="#62646D" TextAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>