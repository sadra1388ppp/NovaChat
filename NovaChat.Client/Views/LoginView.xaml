<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#07080C">
    <Grid x:Name="LoginRoot" Background="#07080C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="20" ShadowDepth="7" Opacity="0.58" />
        </Grid.Resources>

        <Border x:Name="WarmLightOverlay" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.23,0.28" GradientOrigin="0.23,0.28" RadiusX="0.72" RadiusY="0.78">
                    <GradientStop Color="#FFFFE7A0" Offset="0" />
                    <GradientStop Color="#FFF5C85B" Offset="0.20" />
                    <GradientStop Color="#8CD59D43" Offset="0.48" />
                    <GradientStop Color="#00D59D43" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="0" MinWidth="420">
            <Canvas x:Name="LampCanvas" Width="500" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" MouseMove="LampCanvas_MouseMove" MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">
                <Ellipse x:Name="LampGlow" Width="450" Height="450" Canvas.Left="25" Canvas.Top="0" IsHitTestVisible="False" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF8D6" Offset="0" />
                            <GradientStop Color="#FFF5D36A" Offset="0.22" />
                            <GradientStop Color="#55E4B94D" Offset="0.52" />
                            <GradientStop Color="#00E4B94D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path x:Name="SuspensionWire" Stroke="#41434B" StrokeThickness="2.5" Data="M 250,0 L 250,105" IsHitTestVisible="False" />

                <!-- Simple premium hanging lamp: canopy + cable + dome shade + single bulb -->
                <Canvas x:Name="LampAssembly" Width="250" Height="205" Canvas.Left="125" Canvas.Top="78" RenderTransformOrigin="0.5,0" Effect="{StaticResource LampShadow}">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>

                    <!-- Ceiling canopy -->
                    <Ellipse Width="54" Height="17" Canvas.Left="98" Canvas.Top="0" Fill="#191B21" Stroke="#74767D" StrokeThickness="1.8" />
                    <Ellipse Width="38" Height="10" Canvas.Left="106" Canvas.Top="3.5" Fill="#2D3037" Stroke="#9B9DA3" StrokeThickness="1" />

                    <!-- Short metal stem -->
                    <Rectangle Width="7" Height="34" Canvas.Left="121.5" Canvas.Top="12" RadiusX="3" RadiusY="3" Fill="#676971" />
                    <Ellipse Width="13" Height="7" Canvas.Left="118.5" Canvas.Top="43" Fill="#272930" Stroke="#8B8D94" StrokeThickness="1" />

                    <!-- Classic dome shade -->
                    <Path Data="M 31,52 Q 125,24 219,52 L 207,94 Q 196,126 165,143 Q 125,164 85,143 Q 54,126 43,94 Z" Stroke="#74767E" StrokeThickness="2.2">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                                <GradientStop Color="#3B3D46" Offset="0" />
                                <GradientStop Color="#22242C" Offset="0.46" />
                                <GradientStop Color="#111217" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <Path Data="M 43,53 Q 125,30 207,53" Stroke="#B9BBC0" StrokeThickness="2.5" Opacity="0.38" IsHitTestVisible="False" />
                    <Path Data="M 57,61 Q 125,42 193,61" Stroke="#8B8D94" StrokeThickness="1.5" Opacity="0.32" IsHitTestVisible="False" />

                    <!-- Warm inner reflector -->
                    <Path x:Name="LampReflector" Data="M 48,91 Q 125,72 202,91 Q 191,124 160,139 Q 125,153 90,139 Q 59,124 48,91 Z" Stroke="#777981" StrokeThickness="1.7">
                        <Path.Fill>
                            <SolidColorBrush Color="#282A31" />
                        </Path.Fill>
                    </Path>

                    <!-- Bulb socket -->
                    <Rectangle Width="26" Height="22" Canvas.Left="112" Canvas.Top="66" RadiusX="4" RadiusY="4" Fill="#3E4048" Stroke="#888A91" StrokeThickness="1.4" />
                    <Rectangle Width="18" Height="4" Canvas.Left="116" Canvas.Top="70" RadiusX="2" RadiusY="2" Fill="#696B73" />
                    <Rectangle Width="18" Height="4" Canvas.Left="116" Canvas.Top="77" RadiusX="2" RadiusY="2" Fill="#696B73" />

                    <!-- One real bulb, not a chandelier -->
                    <Ellipse x:Name="LampBulbGlow" Width="82" Height="82" Canvas.Left="84" Canvas.Top="82" Fill="#FFF3A6" Opacity="0.04" IsHitTestVisible="False" />
                    <Ellipse x:Name="LampBulb" Width="43" Height="56" Canvas.Left="103.5" Canvas.Top="83" Stroke="#A4A6AC" StrokeThickness="1.8">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#454751" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="30" Height="40" Canvas.Left="110" Canvas.Top="91" Fill="#777A83" Opacity="0.34" IsHitTestVisible="False" />
                    <Path Data="M 116,101 L 125,94 L 134,101 M 116,109 L 125,102 L 134,109 M 116,117 L 125,110 L 134,117 M 116,125 L 125,118 L 134,125" Stroke="#D7D8DA" StrokeThickness="1.1" Opacity="0.3" IsHitTestVisible="False" />

                    <!-- Shade rim -->
                    <Ellipse x:Name="LampShadeGlow" Width="132" Height="24" Canvas.Left="59" Canvas.Top="126" Fill="#202229" Stroke="#898B92" StrokeThickness="2.2" />
                    <Ellipse Width="108" Height="15" Canvas.Left="71" Canvas.Top="130.5" Fill="#090A0E" Opacity="0.75" IsHitTestVisible="False" />
                </Canvas>

                <Path x:Name="PullCord" Stroke="#AFA17D" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                <Ellipse x:Name="LampPull" Width="23" Height="23" Canvas.Left="238.5" Canvas.Top="350" Fill="#AFA16F" Stroke="#E8D99C" StrokeThickness="2" Cursor="Hand" MouseLeftButtonDown="LampPull_MouseLeftButtonDown">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="LampPullTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <StackPanel Canvas.Left="50" Canvas.Top="485" Width="400" IsHitTestVisible="False">
                    <TextBlock x:Name="WelcomeText" Text="Welcome to NovaChat" FontSize="32" FontWeight="Bold" Foreground="#E9E9ED" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeSubText" Text="Pull the light. Sign in. Get back to your conversations." FontSize="14" Foreground="#6E707A" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Canvas>
        </Grid>

        <Grid Grid.Column="1" Margin="42,30,58,30" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="LoginCard" Background="#12141B" BorderBrush="#292C36" BorderThickness="1" CornerRadius="24" Padding="34">
                <Border.Effect>
                    <DropShadowEffect x:Name="LoginCardShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="SignInTitle" Text="Sign in" FontSize="30" FontWeight="Bold" Foreground="#E9E9ED" />
                    <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account" FontSize="14" Foreground="#777983" Margin="0,6,0,28" />
                    <TextBlock Text="User ID" FontSize="12" FontWeight="SemiBold" Foreground="#858792" Margin="0,0,0,7" />
                    <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,17" />
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#858792" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,22" />
                    <Button x:Name="LoginButton" Content="Sign in" Height="50" FontSize="15" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" />
                    <TextBlock Text="Don't have an account?" HorizontalAlignment="Center" Foreground="#777983" Margin="0,23,0,4" />
                    <Button Content="Create a new account" Height="38" Style="{StaticResource GhostButtonStyle}" Foreground="#D6B94F" Click="CreateAccountButton_Click" />
                    <TextBlock Text="Your credentials are protected by NovaChat authentication." FontSize="11" Foreground="#62646D" TextAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>