<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#07080C">
    <Grid x:Name="LoginRoot" Background="#07080C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="WarmLightOverlay"
                Grid.ColumnSpan="2"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.23,0.28"
                                     GradientOrigin="0.23,0.28"
                                     RadiusX="0.72"
                                     RadiusY="0.78">
                    <GradientStop Color="#FFFFE7A0" Offset="0" />
                    <GradientStop Color="#FFF5C85B" Offset="0.20" />
                    <GradientStop Color="#8CD59D43" Offset="0.48" />
                    <GradientStop Color="#00D59D43" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="0" MinWidth="420">
            <Canvas x:Name="LampCanvas"
                    Width="500"
                    Height="650"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    MouseMove="LampCanvas_MouseMove"
                    MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">

                <Ellipse x:Name="LampGlow"
                         Width="390"
                         Height="390"
                         Canvas.Left="55"
                         Canvas.Top="45"
                         IsHitTestVisible="False"
                         Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF5C4" Offset="0" />
                            <GradientStop Color="#FFF5CF62" Offset="0.25" />
                            <GradientStop Color="#45E4B94D" Offset="0.58" />
                            <GradientStop Color="#00E4B94D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path x:Name="SuspensionWire"
                      Stroke="#41434B"
                      StrokeThickness="3"
                      Data="M 250,0 L 250,105"
                      IsHitTestVisible="False" />

                <Canvas x:Name="LampAssembly"
                        Width="190"
                        Height="170"
                        Canvas.Left="155"
                        Canvas.Top="88"
                        RenderTransformOrigin="0.5,0">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>

                    <Ellipse Width="22"
                             Height="22"
                             Canvas.Left="84"
                             Canvas.Top="0"
                             Fill="#383A42"
                             Stroke="#555761"
                             StrokeThickness="1.5" />

                    <Rectangle Width="8"
                               Height="18"
                               Canvas.Left="91"
                               Canvas.Top="16"
                               RadiusX="3"
                               RadiusY="3"
                               Fill="#44464F" />

                    <Path Data="M 30,32 Q 95,4 160,32 L 139,116 Q 95,151 51,116 Z"
                          Fill="#22242C"
                          Stroke="#5A5C66"
                          StrokeThickness="3" />

                    <Path Data="M 45,40 Q 95,17 145,40"
                          Stroke="#72747D"
                          StrokeThickness="2"
                          Opacity="0.55"
                          IsHitTestVisible="False" />

                    <Ellipse x:Name="LampShadeGlow"
                             Width="94"
                             Height="27"
                             Canvas.Left="48"
                             Canvas.Top="103"
                             Fill="#1B1C22"
                             Stroke="#676974"
                             StrokeThickness="2" />

                    <Ellipse x:Name="LampBulb"
                             Width="42"
                             Height="42"
                             Canvas.Left="74"
                             Canvas.Top="91"
                             Fill="#41434D"
                             Stroke="#777985"
                             StrokeThickness="2" />
                </Canvas>

                <!-- The pull cord is attached directly to the bottom of the lamp. -->
                <Path x:Name="PullCord"
                      Stroke="#AFA17D"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />

                <Ellipse x:Name="LampPull"
                         Width="25"
                         Height="25"
                         Canvas.Left="237.5"
                         Canvas.Top="350"
                         Fill="#AFA16F"
                         Stroke="#E8D99C"
                         StrokeThickness="2"
                         Cursor="Hand"
                         MouseLeftButtonDown="LampPull_MouseLeftButtonDown" />

                <TextBlock x:Name="PullHint"
                           Text="pull the cord"
                           Canvas.Left="145"
                           Canvas.Top="614"
                           Width="210"
                           TextAlignment="Center"
                           FontSize="13"
                           Foreground="#777983"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="WelcomeText"
                           Text="Welcome to NovaChat"
                           Canvas.Left="65"
                           Canvas.Top="465"
                           Width="370"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#E9E9ED"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="WelcomeSubText"
                           Text="Pull the light. Sign in. Get back to your conversations."
                           Canvas.Left="70"
                           Canvas.Top="523"
                           Width="360"
                           FontSize="14"
                           Foreground="#6E707A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />
            </Canvas>
        </Grid>

        <Grid Grid.Column="1"
              Margin="42,30,58,30"
              MaxWidth="430"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="LoginCard"
                    Background="#12141B"
                    BorderBrush="#292C36"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="34">
                <StackPanel>
                    <TextBlock x:Name="SignInTitle"
                               Text="Sign in"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#E9E9ED" />
                    <TextBlock x:Name="SignInSubtitle"
                               Text="Continue to your NovaChat account"
                               FontSize="14"
                               Foreground="#777983"
                               Margin="0,6,0,28" />

                    <TextBlock Text="User ID"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858792"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="UserIdTextBox"
                             Height="48"
                             Margin="0,0,0,17" />

                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#858792"
                               Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox"
                                 Height="48"
                                 Margin="0,0,0,22" />

                    <Button x:Name="LoginButton"
                            Content="Sign in"
                            Height="50"
                            FontSize="15"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoginButton_Click" />

                    <TextBlock Text="Don't have an account?"
                               HorizontalAlignment="Center"
                               Foreground="#777983"
                               Margin="0,23,0,4" />
                    <Button Content="Create a new account"
                            Height="38"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="#D6B94F"
                            Click="CreateAccountButton_Click" />

                    <TextBlock Text="Your credentials are protected by NovaChat authentication."
                               FontSize="11"
                               Foreground="#62646D"
                               TextAlignment="Center"
                               Margin="0,24,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>