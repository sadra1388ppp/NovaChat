<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="LoginRoot" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="34" CornerRadius="28" Background="{DynamicResource PrimaryBrush}">
            <Grid>
                <Border x:Name="LampGlowOverlay"
                        Background="#FFF4C95D"
                        CornerRadius="28"
                        Opacity="0"
                        IsHitTestVisible="False"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <Button x:Name="LampButton"
                            Click="LampButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            ToolTip="Pull the cord to turn the light on/off">
                        <Grid Width="150" Height="250">
                            <Rectangle Width="4" Height="86" Fill="#F7E7B5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                            <Ellipse Width="18" Height="18" Fill="#FFF4C95D" Stroke="#FFFDF4D5" StrokeThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,78,0,0"/>
                            <Path Data="M 38,104 Q 75,145 112,104 L 98,158 Q 75,180 52,158 Z"
                                  Fill="#FFF4C95D"
                                  Stroke="#FFFDF4D5"
                                  StrokeThickness="3"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"/>
                            <Ellipse Width="46" Height="14" Fill="#FFF9E8A8" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,151,0,0"/>
                            <Rectangle x:Name="LampCord" Width="3" Height="55" Fill="#F7E7B5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,165,0,0"/>
                            <Ellipse x:Name="LampPull"
                                     Width="18" Height="18"
                                     Fill="#FFF4C95D"
                                     Stroke="#FFFDF4D5"
                                     StrokeThickness="2"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center"
                                     Margin="0,215,0,0"/>
                        </Grid>
                    </Button>

                    <TextBlock Text="Pull the cord"
                               FontSize="13"
                               Foreground="#FFF8F3D7"
                               HorizontalAlignment="Center"
                               Margin="0,-8,0,18"/>
                    <TextBlock Text="Welcome to NovaChat"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Turn on the light, sign in, and get back to your conversations."
                               FontSize="15"
                               Foreground="#E9EAFF"
                               Margin="0,12,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,30,58,30" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="LoginCard"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="34">
                <StackPanel>
                    <TextBlock Text="Sign in"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Continue to your NovaChat account"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,6,0,28"/>

                    <TextBlock Text="User ID"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,7"/>
                    <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,17"/>

                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,7"/>
                    <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,22"/>

                    <Button x:Name="LoginButton"
                            Content="Sign in"
                            Height="50"
                            FontSize="15"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoginButton_Click"/>
                    <TextBlock Text="Don't have an account?"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,23,0,4"/>
                    <Button Content="Create a new account"
                            Height="38"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Click="CreateAccountButton_Click"/>
                    <TextBlock Text="Your credentials are protected by NovaChat authentication."
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               Margin="0,24,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="WarmLightOverlay"
                Grid.ColumnSpan="2"
                Background="#FFF6D76A"
                Opacity="0"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>