<UserControl x:Class="NovaChat.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#121417">
    <Grid x:Name="LoginRoot" Background="#121417">
        <Grid.Resources>
            <DropShadowEffect x:Key="LampShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
        </Grid.Resources>

        <Border x:Name="WarmLightOverlay" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
                <RadialGradientBrush Center="0.27,0.40" GradientOrigin="0.27,0.40" RadiusX="0.62" RadiusY="0.68">
                    <GradientStop Color="#FFFFF3B8" Offset="0" />
                    <GradientStop Color="#70FFD66E" Offset="0.22" />
                    <GradientStop Color="#28FFD66E" Offset="0.48" />
                    <GradientStop Color="#00FFD66E" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="35,0,35,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>

            <!-- Lamp side: based directly on Coding Stella's SVG proportions. -->
            <Grid Grid.Column="0" Width="330" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="LampCanvas" Width="330" Height="430"
                        Background="Transparent"
                        MouseMove="LampCanvas_MouseMove"
                        MouseLeftButtonUp="LampCanvas_MouseLeftButtonUp">

                    <Ellipse x:Name="LampGlow" Width="310" Height="310" Canvas.Left="10" Canvas.Top="10"
                             IsHitTestVisible="False" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFFF8D6" Offset="0" />
                                <GradientStop Color="#FFFFDB8A" Offset="0.20" />
                                <GradientStop Color="#45FFD66E" Offset="0.50" />
                                <GradientStop Color="#00FFD66E" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- The reference lamp itself is centered around the 200x300 SVG. -->
                    <Canvas x:Name="LampAssembly" Width="200" Height="300" Canvas.Left="65" Canvas.Top="114"
                            RenderTransformOrigin="0.5,0.36" Effect="{StaticResource LampShadow}">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="LampRotateTransform" Angle="0" />
                        </Canvas.RenderTransform>

                        <!-- SVG: <rect x="92" y="100" width="16" height="160" rx="8"> -->
                        <Rectangle Width="16" Height="160" Canvas.Left="92" Canvas.Top="100"
                                   RadiusX="8" RadiusY="8" Fill="#D1CCC2" />

                        <!-- SVG: <rect x="60" y="250" width="80" height="12" rx="6"> -->
                        <Rectangle Width="80" Height="12" Canvas.Left="60" Canvas.Top="250"
                                   RadiusX="6" RadiusY="6" Fill="#D1CCC2" />

                        <!-- SVG lamp shade: same silhouette and dimensions as the reference. -->
                        <Path x:Name="LampBulb"
                              Data="M 30,110 C 30,50 170,50 170,110 C 170,125 30,125 30,110 Z"
                              Fill="#F5F0E6" />

                        <Path x:Name="LampShadeGlow"
                              Data="M 30,110 C 30,50 170,50 170,110 C 170,125 30,125 30,110 Z"
                              Fill="#FFFFFF" Opacity="0.04" IsHitTestVisible="False" />

                        <Ellipse x:Name="LampBulbGlow" Width="120" Height="60" Canvas.Left="40" Canvas.Top="76"
                                 Fill="#FFDB8A" Opacity="0" IsHitTestVisible="False" />

                        <!-- Compatibility element for the existing animation code. -->
                        <Path x:Name="LampReflector" Data="M 0,0 L 0,0" Fill="#282A31" Opacity="0" IsHitTestVisible="False" />
                    </Canvas>

                    <!-- IMPORTANT: cord is drawn independently and starts exactly at the underside of the shade. -->
                    <Path x:Name="PullCord"
                          Stroke="#555555"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          IsHitTestVisible="False" />

                    <!-- Exact circular pull bead, kept separate so the existing physics can drag it smoothly. -->
                    <Ellipse x:Name="LampPull" Width="14" Height="14" Canvas.Left="243" Canvas.Top="343"
                             Fill="#D4A373" Stroke="#E8C79C" StrokeThickness="1"
                             Cursor="Hand"
                             MouseLeftButtonDown="LampPull_MouseLeftButtonDown"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LampPullTransform" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <StackPanel Canvas.Left="15" Canvas.Top="20" Width="300" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="WelcomeText" Text="Welcome to NovaChat" FontSize="25" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextAlignment="Center" />
                        <TextBlock x:Name="WelcomeSubText" Text="Pull the light to continue" FontSize="12"
                                   Foreground="#8D9299" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Canvas>
            </Grid>

            <!-- Login is intentionally pushed far to the RIGHT with a clear empty gap. -->
            <Grid Grid.Column="1" Width="390" Margin="105,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border x:Name="LoginCard"
                        Background="#0D0F13"
                        BorderBrush="#FFFFFF1A"
                        BorderThickness="1"
                        CornerRadius="30"
                        Padding="32"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect x:Name="LoginCardShadow" BlurRadius="40" ShadowDepth="18" Opacity="0.3" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="SignInTitle" Text="Welcome" FontSize="25" FontWeight="Medium"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,25" />

                        <TextBlock Text="User ID" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                        <TextBox x:Name="UserIdTextBox" Height="48" Margin="0,0,0,18"
                                 Background="#12FFFFFF" Foreground="#FFFFFF"
                                 BorderBrush="#12FFFFFF" Padding="14,0" VerticalContentAlignment="Center" />

                        <TextBlock Text="Password" FontSize="12" Foreground="#999999" Margin="5,0,0,7" />
                        <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,0,0,20"
                                     Background="#12FFFFFF" Foreground="#FFFFFF"
                                     BorderBrush="#12FFFFFF" Padding="14,0" VerticalContentAlignment="Center" />

                        <Button x:Name="LoginButton" Content="Sign In" Height="50" FontSize="15"
                                Background="#D4A373" Foreground="#121417" BorderThickness="0"
                                Click="LoginButton_Click" />

                        <TextBlock x:Name="SignInSubtitle" Text="Continue to your NovaChat account"
                                   FontSize="11" Foreground="#777777" HorizontalAlignment="Center"
                                   Margin="0,18,0,0" />

                        <Button Content="Create a new account" Height="36" Margin="0,8,0,0"
                                Background="Transparent" BorderThickness="0" Foreground="#D4A373"
                                Click="CreateAccountButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>